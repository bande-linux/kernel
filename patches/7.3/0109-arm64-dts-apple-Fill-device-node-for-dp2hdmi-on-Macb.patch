From ede91c703a252e0542c69cf39d36a68386e64b7b Mon Sep 17 00:00:00 2001
From: Janne Grunau <j@jannau.net>
Date: Mon, 6 Nov 2023 20:39:42 +0100
Subject: [PATCH] arm64: dts: apple: Fill device node for dp2hdmi on Macbook
 Pros

The HDMI output on the 14 and 16 inch Macbook Pros with M1/M2 Pro/Max is
driven by an unused ATC port using the phy and crossbar. The DP output
from any dcpext display controller is routed to a Kinetic DP2HDMI
converter (MCDP2920 and a unknown HDMI 2.1 capable variant).

Signed-off-by: Janne Grunau <j@jannau.net>
(cherry picked from commit 34ef250cacd911079bcf0be140f4f584d54fabb6)
---
 .../arm64/boot/dts/apple/t600x-j314-j316.dtsi | 40 +++++++++++++++++++
 .../arm64/boot/dts/apple/t602x-j414-j416.dtsi |  5 +++
 2 files changed, 45 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t600x-j314-j316.dtsi b/arch/arm64/boot/dts/apple/t600x-j314-j316.dtsi
index 9483e74ac650..5a95785c61c1 100644
--- a/arch/arm64/boot/dts/apple/t600x-j314-j316.dtsi
+++ b/arch/arm64/boot/dts/apple/t600x-j314-j316.dtsi
@@ -21,6 +21,7 @@ aliases {
 		atcphy3 = &atcphy3;
 		bluetooth0 = &bluetooth0;
 		dcp = &dcp;
+		dcpext0 = &dcpext0;
 		disp0 = &display;
 		disp0_piodma = &disp0_piodma;
 		disp0-piodma = &disp0_piodma;
@@ -74,6 +75,45 @@ panel: panel {
 	};
 };
 
+&display {
+	iommus = <&disp0_dart 0 0x0 0x0 0x0 0xfc000000>,
+		<&dispext0_dart 0 0x0 0x0 0x0 0xfc000000>;
+};
+
+&dispext0_dart {
+	status = "okay";
+};
+
+&dcpext0_dart {
+	status = "okay";
+};
+
+&dcpext0_mbox {
+	status = "okay";
+};
+
+&dcpext0 {
+	/* enabled by the loader */
+	apple,connector-type = "HDMI-A";
+
+	/*  HDMI HPD gpio, used as interrupt*/
+	hdmi-hpd-gpios = <&pinctrl_nub 15 GPIO_ACTIVE_HIGH>;
+
+	hdmi-pwren-gpios = <&smc_gpio 23 GPIO_ACTIVE_HIGH>;
+	dp2hdmi-pwren-gpios = <&smc_gpio 6 GPIO_ACTIVE_HIGH>;
+
+	phys = <&atcphy3 PHY_TYPE_DP>;
+	phy-names = "dp-phy";
+	mux-controls = <&atcphy3_xbar 0>;
+	mux-control-names = "dp-xbar";
+	mux-index = <0>;
+	apple,dptx-phy = <3>;
+};
+
+&atcphy3_xbar {
+	status = "okay";
+};
+
 /* USB Type C */
 &i2c0 {
 	hpm0: usb-pd@38 {
diff --git a/arch/arm64/boot/dts/apple/t602x-j414-j416.dtsi b/arch/arm64/boot/dts/apple/t602x-j414-j416.dtsi
index 89d842d69938..428e8d009bac 100644
--- a/arch/arm64/boot/dts/apple/t602x-j414-j416.dtsi
+++ b/arch/arm64/boot/dts/apple/t602x-j414-j416.dtsi
@@ -39,6 +39,11 @@ &ps_dptx_phy_ps {
 	apple,always-on;
 };
 
+&dcpext0 {
+	/*  HDMI HPD gpio, used as interrupt*/
+	hdmi-hpd-gpios = <&pinctrl_aop 25 GPIO_ACTIVE_HIGH>;
+};
+
 &hpm0 {
 	interrupts = <44 IRQ_TYPE_LEVEL_LOW>;
 };
-- 
2.47.3

