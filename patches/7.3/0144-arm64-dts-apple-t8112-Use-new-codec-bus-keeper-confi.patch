From a7ee1bf8ab4686145ade60a59e8715626cccce09 Mon Sep 17 00:00:00 2001
From: James Calligeros <jcalligeros99@gmail.com>
Date: Sun, 21 Jun 2026 21:13:03 +1000
Subject: [PATCH] arm64: dts: apple: t8112: Use new codec bus keeper config

Signed-off-by: James Calligeros <jcalligeros99@gmail.com>
(cherry picked from commit 25ac3b087ee0ddd7d668386f84b187c435c61c48)
---
 arch/arm64/boot/dts/apple/t8112-j413.dts | 6 ++++--
 arch/arm64/boot/dts/apple/t8112-j415.dts | 6 ++++--
 arch/arm64/boot/dts/apple/t8112-j493.dts | 6 ++++--
 3 files changed, 12 insertions(+), 6 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t8112-j413.dts b/arch/arm64/boot/dts/apple/t8112-j413.dts
index 6221935058c7..6a49b6727e3f 100644
--- a/arch/arm64/boot/dts/apple/t8112-j413.dts
+++ b/arch/arm64/boot/dts/apple/t8112-j413.dts
@@ -111,7 +111,6 @@ speaker_left_woof: codec@38 {
 		interrupts-extended = <&pinctrl_ap 11 IRQ_TYPE_LEVEL_LOW>;
 		ti,imon-slot-no = <0>;
 		ti,vmon-slot-no = <2>;
-		ti,sdout-force-zero-mask = <0xf0f0>;
 	};
 
 	speaker_left_tweet: codec@39 {
@@ -136,7 +135,6 @@ speaker_right_woof: codec@3b {
 		interrupts-extended = <&pinctrl_ap 11 IRQ_TYPE_LEVEL_LOW>;
 		ti,imon-slot-no = <4>;
 		ti,vmon-slot-no = <6>;
-		ti,sdout-force-zero-mask = <0x0f0f>;
 	};
 
 	speaker_right_tweet: codec@3c {
@@ -196,6 +194,10 @@ sound {
 
 		dai-link@0 {
 			link-name = "Speakers";
+			dai-tdm-idle-mode-0 = "zero";
+			dai-tdm-idle-mode-2 = "zero";
+			dai-tdm-slot-tx-idle-mask-0 = <0xf0f0>;
+			dai-tdm-slot-tx-idle-mask-2 = <0x0f0f>;
 
 			cpu {
 				sound-dai = <&mca 0>, <&mca 1>;
diff --git a/arch/arm64/boot/dts/apple/t8112-j415.dts b/arch/arm64/boot/dts/apple/t8112-j415.dts
index 6c5175af6f3e..7dfd891fd4c1 100644
--- a/arch/arm64/boot/dts/apple/t8112-j415.dts
+++ b/arch/arm64/boot/dts/apple/t8112-j415.dts
@@ -111,7 +111,6 @@ speaker_left_woof1: codec@38 {
 		interrupts-extended = <&pinctrl_ap 11 IRQ_TYPE_LEVEL_LOW>;
 		ti,imon-slot-no = <0>;
 		ti,vmon-slot-no = <2>;
-		ti,sdout-force-zero-mask = <0xf0f0f0>;
 	};
 
 	speaker_left_tweet: codec@39 {
@@ -147,7 +146,6 @@ speaker_right_woof1: codec@3b {
 		interrupts-extended = <&pinctrl_ap 11 IRQ_TYPE_LEVEL_LOW>;
 		ti,imon-slot-no = <4>;
 		ti,vmon-slot-no = <6>;
-		ti,sdout-force-zero-mask = <0x0f0f0f>;
 	};
 
 	speaker_right_tweet: codec@3c {
@@ -218,6 +216,10 @@ sound {
 
 		dai-link@0 {
 			link-name = "Speakers";
+			dai-tdm-idle-mode-0 = "zero";
+			dai-tdm-idle-mode-3 = "zero";
+			dai-tdm-slot-tx-idle-mask-0 = <0xf0f0f0>;
+			dai-tdm-slot-tx-idle-mask-3 = <0x0f0f0f>;
 
 			cpu {
 				sound-dai = <&mca 0>, <&mca 1>;
diff --git a/arch/arm64/boot/dts/apple/t8112-j493.dts b/arch/arm64/boot/dts/apple/t8112-j493.dts
index 3a7b7cc5fcb8..49d3c8548dcf 100644
--- a/arch/arm64/boot/dts/apple/t8112-j493.dts
+++ b/arch/arm64/boot/dts/apple/t8112-j493.dts
@@ -158,7 +158,6 @@ speaker_left_front: codec@39 {
 		interrupts-extended = <&pinctrl_ap 11 IRQ_TYPE_LEVEL_LOW>;
 		ti,imon-slot-no = <0>;
 		ti,vmon-slot-no = <2>;
-		ti,sdout-force-zero-mask = <0xf0f0>;
 	};
 };
 
@@ -183,7 +182,6 @@ speaker_right_front: codec@3c {
 		interrupts-extended = <&pinctrl_ap 11 IRQ_TYPE_LEVEL_LOW>;
 		ti,imon-slot-no = <4>;
 		ti,vmon-slot-no = <6>;
-		ti,sdout-force-zero-mask = <0x0f0f>;
 	};
 
 	jack_codec: codec@4b {
@@ -250,6 +248,10 @@ sound {
 
 		dai-link@0 {
 			link-name = "Speakers";
+			dai-tdm-slot-tx-idle-mode-0 = "zero";
+			dai-tdm-slot-tx-idle-mode-2 = "zero";
+			dai-tdm-slot-tx-idle-mask-0 = <0xf0f0>;
+			dai-tdm-slot-tx-idle-mask-2 = <0x0f0f>;
 
 			cpu {
 				sound-dai = <&mca 0>, <&mca 1>;
-- 
2.47.3

