+	u8 flag2;
+	u8 padding[2];
+} __packed;
+
+/*
+ * Update background color to struct dcp_swap.bg_color
+ */
+#define IOMFB_SET_BACKGROUND	BIT(31)
+
+struct dcp_allocate_bandwidth_req {
