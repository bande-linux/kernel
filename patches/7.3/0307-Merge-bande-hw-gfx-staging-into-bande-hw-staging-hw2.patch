+/// Exclusive access to a [`Vm`]'s GPUVM state: the VA tree, the page tables and the
+/// mm allocator. Every map, unmap and remap of the Vm runs with it held.
+type VmLock = Arc<Mutex<gpuvm::UniqueRefGpuVm<VmInner>>>;
