From ba7ae66cda0cdb27bf1f82141310a5d09af8f4af Mon Sep 17 00:00:00 2001
From: Janne Grunau <j@jannau.net>
Date: Fri, 3 Apr 2026 12:36:06 +0200
Subject: [PATCH] arm64: dts: apple: t8122: Add PCI power enable GPIOs

- WLAN/BT (SMC PMU GPIO #13) (all devices)
- ASM3142 (SMC PMU GPIO #14) (j434, iMac with 4 USB-C ports)
- SD card reader (SMC PMU GPIO #23) (j504, 14-inch MacBook Pro)

Signed-off-by: Janne Grunau <j@jannau.net>
(cherry picked from commit ad0202b84fd0cbbe4e73028cba023e4e1e1aaa1c)
---
 arch/arm64/boot/dts/apple/t8122-j434.dts  | 1 +
 arch/arm64/boot/dts/apple/t8122-j504.dts  | 1 +
 arch/arm64/boot/dts/apple/t8122-jxxx.dtsi | 1 +
 3 files changed, 3 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8122-j434.dts b/arch/arm64/boot/dts/apple/t8122-j434.dts
index ecfd9e9b9ccf..32a9d7c3df8c 100644
--- a/arch/arm64/boot/dts/apple/t8122-j434.dts
+++ b/arch/arm64/boot/dts/apple/t8122-j434.dts
@@ -38,6 +38,7 @@ ethernet0: ethernet@0,0 {
 
 &port02 {
 	bus-range = <3 3>;
+	pwren-gpios = <&smc_gpio 14 GPIO_ACTIVE_HIGH>;
 	status = "okay";
 };
 
diff --git a/arch/arm64/boot/dts/apple/t8122-j504.dts b/arch/arm64/boot/dts/apple/t8122-j504.dts
index d83b7e5b32e6..d285ae37f30a 100644
--- a/arch/arm64/boot/dts/apple/t8122-j504.dts
+++ b/arch/arm64/boot/dts/apple/t8122-j504.dts
@@ -42,6 +42,7 @@ &bluetooth0 {
 &port01 {
 	/* SD card reader */
 	bus-range = <2 2>;
+	pwren-gpios = <&smc_gpio 23 GPIO_ACTIVE_HIGH>;
 	status = "okay";
 
 	sdhci0: mmc@0,0 {
diff --git a/arch/arm64/boot/dts/apple/t8122-jxxx.dtsi b/arch/arm64/boot/dts/apple/t8122-jxxx.dtsi
index 786adeeb7620..064b72f2075e 100644
--- a/arch/arm64/boot/dts/apple/t8122-jxxx.dtsi
+++ b/arch/arm64/boot/dts/apple/t8122-jxxx.dtsi
@@ -56,6 +56,7 @@ &serial0 {
  */
 &port00 {
 	bus-range = <1 1>;
+	pwren-gpios = <&smc_gpio 13 GPIO_ACTIVE_HIGH>;
 
 	wifi0: wifi@0,0 {
 		compatible = "pci14e4,4434";
-- 
2.47.3

