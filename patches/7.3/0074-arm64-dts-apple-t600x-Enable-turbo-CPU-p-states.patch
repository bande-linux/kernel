From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hector Martin <marcan@marcan.st>
Date: Thu, 27 Apr 2023 13:53:35 +0900
Subject: [PATCH] arm64: dts: apple: t600x: Enable turbo CPU p-states

These should work now that we have cpuidle.

Signed-off-by: Hector Martin <marcan@marcan.st>
(cherry picked from commit db94178778cf3bae0dd5996474d681babf9a4fda)
---
 arch/arm64/boot/dts/apple/t600x-common.dtsi | 2 --
 1 file changed, 2 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t600x-common.dtsi b/arch/arm64/boot/dts/apple/t600x-common.dtsi
index 4a1b8a9..1be32bc 100644
--- a/arch/arm64/boot/dts/apple/t600x-common.dtsi
+++ b/arch/arm64/boot/dts/apple/t600x-common.dtsi
@@ -315,7 +315,6 @@ opp12 {
 			opp-level = <12>;
 			clock-latency-ns = <56000>;
 		};
-		/* Not available until CPU deep sleep is implemented
 		opp13 {
 			opp-hz = /bits/ 64 <3132000000>;
 			opp-level = <13>;
@@ -334,7 +333,6 @@ opp15 {
 			clock-latency-ns = <56000>;
 			turbo-mode;
 		};
-		*/
 	};
 
 	gpu_opp: opp-table-gpu {
