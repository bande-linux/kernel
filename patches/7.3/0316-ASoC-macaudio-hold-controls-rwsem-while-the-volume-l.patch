From b8ab3521a40ef7f0ebf7e7351892af50bc27ece9 Mon Sep 17 00:00:00 2001
From: Mikael Hug <mikaelhug@gmail.com>
Date: Fri, 30 Oct 2026 16:39:37 +0000
Subject: [PATCH] ASoC: macaudio: hold controls_rwsem while the volume limit
 walks the controls

macaudio_vlimit_update() checks the owner of every speaker volume
control, and macaudio_vlimit_unlock() changes their limit through
snd_soc_limit_volume(). Both walk card->snd_card->controls. When the ALSA
core calls in (control write, lock and unlock) it holds controls_rwsem
for writing, but the timeout work, the update work and late probe reach
the same walk with no lock on the list, racing control addition and
removal and the owner changes made by snd_ctl_elem_lock().

Take controls_rwsem for reading in those three paths, before
volume_lock_mutex, which keeps the order the core-driven paths already
use.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01UqitcmCNS6G33aQUShi39x
---
 sound/soc/apple/macaudio.c | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/sound/soc/apple/macaudio.c b/sound/soc/apple/macaudio.c
index fda5d49462f7..772238ee7148 100644
--- a/sound/soc/apple/macaudio.c
+++ b/sound/soc/apple/macaudio.c
@@ -322,6 +322,7 @@ static void macaudio_vlimit_update(struct macaudio_snd_data *ma)
 
 static void macaudio_vlimit_enable_timeout(struct macaudio_snd_data *ma)
 {
+	guard(rwsem_read)(&ma->card.snd_card->controls_rwsem);
 	mutex_lock(&ma->volume_lock_mutex);
 
 	if (ma->speaker_lock_timeout_enabled) {
@@ -346,6 +347,7 @@ static void macaudio_vlimit_disable_timeout(struct macaudio_snd_data *ma)
 {
 	ktime_t now;
 
+	guard(rwsem_read)(&ma->card.snd_card->controls_rwsem);
 	mutex_lock(&ma->volume_lock_mutex);
 
 	if (!ma->speaker_lock_timeout_enabled) {
@@ -377,6 +379,7 @@ static void macaudio_vlimit_timeout_work(struct work_struct *wrk)
         struct macaudio_snd_data *ma = container_of(to_delayed_work(wrk),
 						    struct macaudio_snd_data, lock_timeout_work);
 
+	guard(rwsem_read)(&ma->card.snd_card->controls_rwsem);
 	mutex_lock(&ma->volume_lock_mutex);
 
 	ma->speaker_lock_remain = 0;
@@ -1209,9 +1212,9 @@ static int macaudio_late_probe(struct snd_soc_card *card)
 		ma->speaker_lock_kctl = snd_soc_card_get_kcontrol(card,
 								  "Speaker Volume Unlock");
 
-		mutex_lock(&ma->volume_lock_mutex);
+		guard(rwsem_read)(&card->snd_card->controls_rwsem);
+		guard(mutex)(&ma->volume_lock_mutex);
 		macaudio_vlimit_unlock(ma, false);
-		mutex_unlock(&ma->volume_lock_mutex);
 	}
 
 	return 0;
