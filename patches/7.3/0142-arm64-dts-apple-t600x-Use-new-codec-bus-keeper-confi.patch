From 9fe41f71a6f8f53f8c6afd4cf37ebfc32b3d8b4b Mon Sep 17 00:00:00 2001
From: James Calligeros <jcalligeros99@gmail.com>
Date: Sun, 21 Jun 2026 21:02:05 +1000
Subject: [PATCH] arm64: dts: apple: t600x: Use new codec bus keeper
 configuration

Signed-off-by: James Calligeros <jcalligeros99@gmail.com>
(cherry picked from commit 293b37f3cc14fb53e36feb77539a1a424e855769)
---
 arch/arm64/boot/dts/apple/t600x-j314-j316.dtsi | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t600x-j314-j316.dtsi b/arch/arm64/boot/dts/apple/t600x-j314-j316.dtsi
index 391bcdaedd66..567ddaf6213e 100644
--- a/arch/arm64/boot/dts/apple/t600x-j314-j316.dtsi
+++ b/arch/arm64/boot/dts/apple/t600x-j314-j316.dtsi
@@ -272,7 +272,6 @@ speaker_left_woof1: codec@38 {
 		interrupts-extended = <&pinctrl_ap 179 IRQ_TYPE_LEVEL_LOW>;
 		ti,imon-slot-no = <0>;
 		ti,vmon-slot-no = <2>;
-		ti,sdout-force-zero-mask = <0xf0f0f0>;
 	};
 
 	speaker_left_woof2: codec@39 {
@@ -323,7 +322,6 @@ speaker_right_woof1: codec@3b {
 		interrupts-extended = <&pinctrl_ap 179 IRQ_TYPE_LEVEL_LOW>;
 		ti,imon-slot-no = <4>;
 		ti,vmon-slot-no = <6>;
-		ti,sdout-force-zero-mask = <0x0f0f0f>;
 	};
 
 	speaker_right_woof2: codec@3c {
@@ -598,6 +596,10 @@ sound: sound {
 
 		dai-link@0 {
 			link-name = "Speakers";
+			dai-tdm-idle-mode-0 = "zero";
+			dai-tdm-idle-mode-3 = "zero";
+			dai-tdm-slot-tx-idle-mask-0 = <0xf0f0f0>;
+			dai-tdm-slot-tx-idle-mask-3 = <0x0f0f0f>;
 
 			cpu {
 				sound-dai = <&mca 0>, <&mca 1>;
-- 
2.47.3

