+++ b/arch/arm64/boot/dts/apple/t6030-j514s.dts
@@ -65,7 +65,7 @@ &speaker_right_woof2 {
 
 &jack_codec {
 	reset-gpios = <&pinctrl_nub 21 GPIO_ACTIVE_HIGH>;
-	interrupts-extended = <&pinctrl_ap 100 IRQ_TYPE_LEVEL_LOW>;
+	interrupts-extended = <&pinctrl_ap 196 IRQ_TYPE_LEVEL_LOW>;
 };
 
 &aop_audio {
diff --git a/arch/arm64/boot/dts/apple/t6030-j516s.dts b/arch/arm64/boot/dts/apple/t6030-j516s.dts
index 5532faac8ed8..c6fb1c55cecf 100644
--- a/arch/arm64/boot/dts/apple/t6030-j516s.dts
+++ b/arch/arm64/boot/dts/apple/t6030-j516s.dts
@@ -65,7 +65,7 @@ &speaker_right_woof2 {
 
 &jack_codec {
 	reset-gpios = <&pinctrl_nub 21 GPIO_ACTIVE_HIGH>;
-	interrupts-extended = <&pinctrl_ap 100 IRQ_TYPE_LEVEL_LOW>;
+	interrupts-extended = <&pinctrl_ap 196 IRQ_TYPE_LEVEL_LOW>;
 };
 
 &aop_audio {
