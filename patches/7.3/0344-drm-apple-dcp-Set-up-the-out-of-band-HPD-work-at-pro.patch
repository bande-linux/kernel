From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mikael Hug <mikaelhug@gmail.com>
Date: Sat, 31 Oct 2026 03:07:22 +0000
Subject: [PATCH] drm: apple: dcp: Set up the out-of-band HPD work at probe

The out-of-band HPD work, its lock and its stop flag were set up in
component bind and the flag was handled in the suspend/resume paths
shared with DP2HDMI. Set them up once at probe and keep the work
stopped outside bind..unbind with a pair of helpers instead. That ties
the lifetime to the component, leaves the DP2HDMI suspend path alone,
and keeps the change apart from the DCP probe and suspend rework in
flight.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01UqitcmCNS6G33aQUShi39x
---
 drivers/gpu/drm/apple/dcp.c | 33 ++++++++++++++++++++++-----------
 1 file changed, 22 insertions(+), 11 deletions(-)

diff --git a/drivers/gpu/drm/apple/dcp.c b/drivers/gpu/drm/apple/dcp.c
index 86dd1fbf8..3201c0631 100644
--- a/drivers/gpu/drm/apple/dcp.c
+++ b/drivers/gpu/drm/apple/dcp.c
@@ -516,6 +516,23 @@ void dcp_dptx_oob_hotplug(struct platform_device *pdev, bool connected)
 	spin_unlock_irqrestore(&dcp->oob_hpd_lock, flags);
 }
 
+/* Out-of-band HPD events are taken from component bind until unbind */
+static void dcp_oob_hpd_start(struct apple_dcp *dcp)
+{
+	spin_lock_irq(&dcp->oob_hpd_lock);
+	dcp->oob_hpd_events = 0;
+	dcp->oob_hpd_stopped = false;
+	spin_unlock_irq(&dcp->oob_hpd_lock);
+}
+
+static void dcp_oob_hpd_stop(struct apple_dcp *dcp)
+{
+	spin_lock_irq(&dcp->oob_hpd_lock);
+	dcp->oob_hpd_stopped = true;
+	spin_unlock_irq(&dcp->oob_hpd_lock);
+	cancel_work_sync(&dcp->oob_hpd_wq);
+}
+
 static irqreturn_t dcp_dp2hdmi_hpd(int irq, void *data)
 {
 	struct apple_dcp *dcp = data;
@@ -859,11 +876,6 @@ static void dcp_stop_hpd_work(struct apple_dcp *dcp)
 	cancel_work_sync(&dcp->hpd_resume_wq);
 	cancel_work_sync(&dcp->sink_modes_wq);
 	cancel_delayed_work_sync(&dcp->release_wq);
-
-	spin_lock_irq(&dcp->oob_hpd_lock);
-	dcp->oob_hpd_stopped = true;
-	spin_unlock_irq(&dcp->oob_hpd_lock);
-	cancel_work_sync(&dcp->oob_hpd_wq);
 }
 
 void dcp_hpd_suspend(struct platform_device *pdev)
@@ -898,9 +910,6 @@ void dcp_hpd_resume(struct platform_device *pdev)
 	dcp->suspended = false;
 	pending = dcp->hotplug_pending;
 	spin_unlock(&dcp->hotplug_lock);
-	spin_lock_irq(&dcp->oob_hpd_lock);
-	dcp->oob_hpd_stopped = false;
-	spin_unlock_irq(&dcp->oob_hpd_lock);
 	if (dcp->hdmi_hpd_irq)
 		enable_irq(dcp->hdmi_hpd_irq);
 	if (dcp->hdmi_hpd)
@@ -1274,6 +1283,8 @@ static int dcp_comp_bind(struct device *dev, struct device *main, void *data)
 	u32 cpu_ctrl;
 	int ret;
 
+	dcp_oob_hpd_start(dcp);
+
 	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(42));
 	if (ret)
 		return ret;
@@ -1412,6 +1423,7 @@ static void dcp_comp_unbind(struct device *dev, struct device *main, void *data)
 	if (dcp->hdmi_hpd_irq)
 		disable_irq(dcp->hdmi_hpd_irq);
 	dcp_stop_hpd_work(dcp);
+	dcp_oob_hpd_stop(dcp);
 
 	if (dcp->connector_type == DRM_MODE_CONNECTOR_eDP) {
 		cancel_work_sync(&dcp->bl_register_wq);
@@ -1530,10 +1542,9 @@ static int dcp_platform_probe(struct platform_device *pdev)
 	mutex_init(&dcp->modes_lock);
 	mutex_init(&dcp->power_mutex);
 	INIT_WORK(&dcp->sink_modes_wq, dcp_work_sink_modes);
-	INIT_WORK(&dcp->oob_hpd_wq, dcp_work_oob_hpd);
 	spin_lock_init(&dcp->oob_hpd_lock);
-	dcp->oob_hpd_events = 0;
-	dcp->oob_hpd_stopped = false;
+	dcp->oob_hpd_stopped = true;
+	INIT_WORK(&dcp->oob_hpd_wq, dcp_work_oob_hpd);
 	INIT_WORK(&dcp->hpd_resume_wq, dcp_work_hpd_resume);
 	INIT_DELAYED_WORK(&dcp->release_wq, dcp_work_release_display);
 
