Subject: [PATCH] arm64: dts: apple: t600x-j314-j316: Enable AOP

Signed-off-by: Janne Grunau <j@jannau.net>
(cherry picked from commit d5255029094b78d66dcc95fcd3d3395e660c0cac)
---
 arch/arm64/boot/dts/apple/t600x-j314-j316.dtsi | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t600x-j314-j316.dtsi b/arch/arm64/boot/dts/apple/t600x-j314-j316.dtsi
index fb956fa1c241..6b7de4ef31e1 100644
--- a/arch/arm64/boot/dts/apple/t600x-j314-j316.dtsi
+++ b/arch/arm64/boot/dts/apple/t600x-j314-j316.dtsi
@@ -549,6 +549,22 @@ &atcphy3 {
 	status = "disabled";
 };
 
+&aop_mbox {
+       status = "okay";
+};
+
+&aop_dart {
+       status = "okay";
+};
+
+&aop_admac {
+       status = "okay";
+};
+
+&aop {
+       status = "okay";
+};
+
 / {
 	sound: sound {
 		/* compatible is set per machine */
