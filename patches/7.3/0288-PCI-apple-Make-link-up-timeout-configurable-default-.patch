From be9f310877dd0f2b8692aab07edb22aec20713ce Mon Sep 17 00:00:00 2001
From: Hector Martin <marcan@marcan.st>
Date: Thu, 18 May 2023 16:12:39 +0900
Subject: [PATCH] PCI: apple: Make link up timeout configurable, default to
 500ms

We're seeing link up timeouts and it looks like devices are just too
slow. Let's just increase this.

Signed-off-by: Hector Martin <marcan@marcan.st>
(cherry picked from commit 0b7c527542d089d15fffec3707f19d7fa6c55024)
---
 drivers/pci/controller/pcie-apple.c | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/drivers/pci/controller/pcie-apple.c b/drivers/pci/controller/pcie-apple.c
index 8aa60a5455c3..4a2b5c676d75 100644
--- a/drivers/pci/controller/pcie-apple.c
+++ b/drivers/pci/controller/pcie-apple.c
@@ -33,6 +33,10 @@
 
 #include "pci-host-common.h"
 
+static int link_up_timeout = 500;
+module_param(link_up_timeout, int, 0644);
+MODULE_PARM_DESC(link_up_timeout, "PCIe link training timeout in milliseconds");
+
 /* T8103 (original M1) and related SoCs */
 #define CORE_RC_PHYIF_CTL		0x00024
 #define   CORE_RC_PHYIF_CTL_RUN		BIT(0)
@@ -700,7 +704,7 @@ static int apple_pcie_setup_port(struct apple_pcie *pcie,
 	/* start link training */
 	writel_relaxed(PORT_LTSSMCTL_START, port->base + PORT_LTSSMCTL);
 
-	if (!wait_for_completion_timeout(&pcie->event, HZ / 10))
+	if (!wait_for_completion_timeout(&pcie->event, link_up_timeout * HZ / 1000))
 		dev_warn(pcie->dev, "%pOF link didn't come up\n", np);
 
 	return 0;
-- 
