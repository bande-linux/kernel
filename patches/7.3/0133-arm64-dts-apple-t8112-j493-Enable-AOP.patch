From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Janne Grunau <j@jannau.net>
Date: Mon, 30 Dec 2024 15:12:15 +0100
Subject: [PATCH] arm64: dts: apple: t8112-j493: Enable AOP

Signed-off-by: Janne Grunau <j@jannau.net>
(cherry picked from commit f2ece47d6c08894aab66d2c959bfb0a0874cde18)
---
 arch/arm64/boot/dts/apple/t8112-j493.dts | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8112-j493.dts b/arch/arm64/boot/dts/apple/t8112-j493.dts
index 6a19343..7481f82 100644
--- a/arch/arm64/boot/dts/apple/t8112-j493.dts
+++ b/arch/arm64/boot/dts/apple/t8112-j493.dts
@@ -222,6 +222,22 @@ touchbar0: touchbar@0 {
 	};
 };
 
+&aop_mbox {
+       status = "okay";
+};
+
+&aop_dart {
+       status = "okay";
+};
+
+&aop_admac {
+       status = "okay";
+};
+
+&aop {
+	status = "okay";
+};
+
 &aop_audio {
 	apple,chassis-name = "J493";
 	apple,machine-kind = "MacBook Pro";
