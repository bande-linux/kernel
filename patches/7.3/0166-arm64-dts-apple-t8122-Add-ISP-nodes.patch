From cf1d346e9413b95b5d55eb04c710dc04f8eeb48d Mon Sep 17 00:00:00 2001
From: Janne Grunau <j@jannau.net>
Date: Tue, 4 Aug 2026 21:42:33 +0200
Subject: [PATCH] arm64: dts: apple: t8122: Add ISP nodes

The additional isp power-states from 0x4000 to 0x4060 are not in Apple's
device tree and are copied from t8112.dtsi and adapted to macOS trace.

Signed-off-by: Janne Grunau <j@jannau.net>
(cherry picked from commit 97536bad9923d83a8f8be695263e91bfd7626a40)
---
 arch/arm64/boot/dts/apple/t8122-j433.dts  |   6 ++
 arch/arm64/boot/dts/apple/t8122-j434.dts  |   6 ++
 arch/arm64/boot/dts/apple/t8122-j504.dts  |   6 ++
 arch/arm64/boot/dts/apple/t8122-j613.dts  |   7 ++
 arch/arm64/boot/dts/apple/t8122-j615.dts  |   7 ++
 arch/arm64/boot/dts/apple/t8122-pmgr.dtsi | 118 ++++++++++++++++++++++
 arch/arm64/boot/dts/apple/t8122.dtsi      |  51 ++++++++++
 7 files changed, 201 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8122-j433.dts b/arch/arm64/boot/dts/apple/t8122-j433.dts
index e8d5f0964564..9ceb6a6ebcdf 100644
--- a/arch/arm64/boot/dts/apple/t8122-j433.dts
+++ b/arch/arm64/boot/dts/apple/t8122-j433.dts
@@ -75,4 +75,10 @@ codec {
 	};
 };
 
+#include "isp-imx364.dtsi"
+
+&isp {
+	apple,platform-id = <10>;
+};
+
 #include "hwmon-fan-dual.dtsi"
diff --git a/arch/arm64/boot/dts/apple/t8122-j434.dts b/arch/arm64/boot/dts/apple/t8122-j434.dts
index a374c16f794e..1e5d75aa02b4 100644
--- a/arch/arm64/boot/dts/apple/t8122-j434.dts
+++ b/arch/arm64/boot/dts/apple/t8122-j434.dts
@@ -81,4 +81,10 @@ codec {
 	};
 };
 
+#include "isp-imx364.dtsi"
+
+&isp {
+	apple,platform-id = <10>;
+};
+
 #include "hwmon-fan-dual.dtsi"
diff --git a/arch/arm64/boot/dts/apple/t8122-j504.dts b/arch/arm64/boot/dts/apple/t8122-j504.dts
index e1babb6b45e1..8e92ebd7a300 100644
--- a/arch/arm64/boot/dts/apple/t8122-j504.dts
+++ b/arch/arm64/boot/dts/apple/t8122-j504.dts
@@ -243,5 +243,11 @@ codec {
 	};
 };
 
+#include "isp-imx558-cfg0.dtsi"
+
+&isp {
+	apple,platform-id = <4>;
+};
+
 #include "hwmon-fan-dual.dtsi"
 #include "hwmon-laptop.dtsi"
diff --git a/arch/arm64/boot/dts/apple/t8122-j613.dts b/arch/arm64/boot/dts/apple/t8122-j613.dts
index 4d860ac590ed..e38de36873c2 100644
--- a/arch/arm64/boot/dts/apple/t8122-j613.dts
+++ b/arch/arm64/boot/dts/apple/t8122-j613.dts
@@ -193,4 +193,11 @@ tp_accel {
 	};
 };
 
+#include "isp-imx558-cfg0.dtsi"
+
+&isp {
+	apple,platform-id = <18>;
+	apple,temporal-filter = <1>;
+};
+
 #include "hwmon-laptop.dtsi"
diff --git a/arch/arm64/boot/dts/apple/t8122-j615.dts b/arch/arm64/boot/dts/apple/t8122-j615.dts
index 9f795673a1df..38fda19345ec 100644
--- a/arch/arm64/boot/dts/apple/t8122-j615.dts
+++ b/arch/arm64/boot/dts/apple/t8122-j615.dts
@@ -193,4 +193,11 @@ tp_accel {
 	};
 };
 
+#include "isp-imx558-cfg0.dtsi"
+
+&isp {
+	apple,platform-id = <18>;
+	apple,temporal-filter = <1>;
+};
+
 #include "hwmon-laptop.dtsi"
diff --git a/arch/arm64/boot/dts/apple/t8122-pmgr.dtsi b/arch/arm64/boot/dts/apple/t8122-pmgr.dtsi
index 6c7182d72481..662fda943588 100644
--- a/arch/arm64/boot/dts/apple/t8122-pmgr.dtsi
+++ b/arch/arm64/boot/dts/apple/t8122-pmgr.dtsi
@@ -225,6 +225,7 @@ ps_isp_sys: power-controller@1e8 {
 		#power-domain-cells = <0>;
 		#reset-cells = <0>;
 		label = "isp_sys";
+		status = "disabled";
 	};
 
 	ps_avd_sys: power-controller@1f0 {
@@ -951,6 +952,123 @@ ps_sep: power-controller@c00 {
 		apple,always-on;
 	};
 
+	/* There is a dependency tree involved with these PDs,
+	 * but we do not express it here since the ISP driver
+	 * is supposed to sequence them in the right order anyway
+	 * (and we do not know the exact tree structure).
+	 *
+	 * This also works around spurious parent PD activation
+	 * on machines with ISP disabled (desktops).
+	 */
+	ps_isp_set0: power-controller@4000 {
+		compatible = "apple,t8122-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x4000 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "isp_set0";
+		apple,force-disable;
+	};
+
+	ps_isp_set1: power-controller@4008 {
+		compatible = "apple,t8122-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x4008 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "isp_set1";
+		apple,force-disable;
+		apple,force-reset;
+	};
+
+	ps_isp_set2: power-controller@4010 {
+		compatible = "apple,t8122-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x4010 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "isp_set2";
+		apple,force-disable;
+		apple,force-reset;
+	};
+
+	ps_isp_fe: power-controller@4018 {
+		compatible = "apple,t8122-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x4018 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "isp_fe";
+	};
+
+	ps_isp_set4: power-controller@4020 {
+		compatible = "apple,t8122-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x4020 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "isp_set4";
+	};
+
+	ps_isp_set9: power-controller@4028 {
+		compatible = "apple,t8122-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x4028 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "isp_set9";
+	};
+
+	ps_isp_set5: power-controller@4030 {
+		compatible = "apple,t8122-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x4030 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "isp_set5";
+	};
+
+	ps_isp_set6: power-controller@4038 {
+		compatible = "apple,t8122-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x4038 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "isp_set6";
+	};
+
+	ps_isp_set7: power-controller@4040 {
+		compatible = "apple,t8122-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x4040 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "isp_set7";
+	};
+
+	ps_isp_set8: power-controller@4048 {
+		compatible = "apple,t8122-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x4048 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "isp_set8";
+	};
+
+	ps_isp_set10: power-controller@4050 {
+		compatible = "apple,t8122-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x4050 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "isp_set10";
+	};
+
+	ps_isp_set11: power-controller@4058 {
+		compatible = "apple,t8122-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x4058 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "isp_set11";
+	};
+
+	ps_isp_set12: power-controller@4060 {
+		compatible = "apple,t8122-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x4060 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "isp_set12";
+	};
+
 	ps_venc_dma: power-controller@8000 {
 		compatible = "apple,t8122-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
 		reg = <0x8000 4>;
diff --git a/arch/arm64/boot/dts/apple/t8122.dtsi b/arch/arm64/boot/dts/apple/t8122.dtsi
index 2d4f69d943c3..c77beba6f54a 100644
--- a/arch/arm64/boot/dts/apple/t8122.dtsi
+++ b/arch/arm64/boot/dts/apple/t8122.dtsi
@@ -570,6 +570,57 @@ mca: i2s@2a3400000 {
 			#sound-dai-cells = <1>;
 		};
 
+		isp: isp@2a4000000 {
+			compatible = "apple,t8122-isp";
+			iommus = <&isp_dart0 0 0x100 0x0 0x1 0x0>,
+				 <&isp_dart1 0 0x100 0x0 0x1 0x0>,
+				 <&isp_dart2 0 0x100 0x0 0x1 0x0>;
+			reg-names = "coproc", "mbox", "gpio", "mbox2";
+			reg = <0x2 0xa4000000 0x0 0x2000000>,
+				<0x2 0xa64c4000 0x0 0x100>,
+				<0x2 0xa64c41d0 0x0 0x100>,
+				<0x2 0xa64c4454 0x0 0x100>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 311 IRQ_TYPE_LEVEL_HIGH>;
+			power-domains = <&ps_isp_sys>, <&ps_isp_set0>, <&ps_isp_set1>,
+					<&ps_isp_set2>, <&ps_isp_fe>, <&ps_isp_set4>,
+					<&ps_isp_set5>, <&ps_isp_set6>, <&ps_isp_set7>,
+					<&ps_isp_set8>, <&ps_isp_set9>, <&ps_isp_set10>,
+					<&ps_isp_set11>, <&ps_isp_set12>;
+			apple,dart-vm-size = <0x0 0xa0000000>;
+			status = "disabled";
+		};
+
+		isp_dart0: iommu@2a64a8000 {
+			compatible = "apple,t8122-dart", "apple,t8110-dart";
+			reg = <0x2 0xa64a8000 0x0 0x4000>;
+			#iommu-cells = <5>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 316 IRQ_TYPE_LEVEL_HIGH>;
+			power-domains = <&ps_isp_sys>;
+			status = "disabled";
+		};
+
+		isp_dart1: iommu@2a64b4000 {
+			compatible = "apple,t8122-dart", "apple,t8110-dart";
+			reg = <0x2 0xa64b4000 0x0 0x4000>;
+			#iommu-cells = <5>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 316 IRQ_TYPE_LEVEL_HIGH>;
+			power-domains = <&ps_isp_sys>;
+			status = "disabled";
+		};
+
+		isp_dart2: iommu@2a64bc000 {
+			compatible = "apple,t8122-dart", "apple,t8110-dart";
+			reg = <0x2 0xa64bc000 0x0 0x4000>;
+			#iommu-cells = <5>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 316 IRQ_TYPE_LEVEL_HIGH>;
+			power-domains = <&ps_isp_sys>;
+			status = "disabled";
+		};
+
 		nco: clock-controller@2d0044000 {
 			compatible = "apple,t8122-nco", "apple,t8103-nco";
 			reg = <0x2 0xd0044000 0x0 0x14000>;
-- 
2.47.3

