+++ b/arch/arm64/boot/dts/apple/t6030-pmgr.dtsi
@@ -552,6 +552,7 @@ ps_mca0: power-controller@308 {
 		#reset-cells = <0>;
 		label = "mca0";
 		power-domains = <&ps_sio_adma>, <&ps_audio_p>;
+		apple,externally-clocked;
 	};
 
 	ps_dcs0: power-controller@320 {
@@ -669,6 +670,7 @@ ps_mca1: power-controller@388 {
 		#reset-cells = <0>;
 		label = "mca1";
 		power-domains = <&ps_sio_adma>, <&ps_audio_p>;
+		apple,externally-clocked;
 	};
 
 	ps_mca2: power-controller@390 {
@@ -678,6 +680,7 @@ ps_mca2: power-controller@390 {
 		#reset-cells = <0>;
 		label = "mca2";
 		power-domains = <&ps_sio_adma>, <&ps_audio_p>;
+		apple,externally-clocked;
 	};
 
 	ps_mca3: power-controller@398 {
@@ -687,6 +690,7 @@ ps_mca3: power-controller@398 {
 		#reset-cells = <0>;
 		label = "mca3";
 		power-domains = <&ps_sio_adma>, <&ps_audio_p>;
