 arch/arm64/boot/dts/apple/t8122-pmgr.dtsi     |  4 ++
 arch/arm64/boot/dts/apple/t8122.dtsi          | 68 +++++++++++++++++++
 11 files changed, 221 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t6030-pmgr.dtsi b/arch/arm64/boot/dts/apple/t6030-pmgr.dtsi
index 932388ea13c9..70b75372784e 100644
