From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mikael Hug <mikaelhug@gmail.com>
Date: Sat, 31 Oct 2026 00:43:30 +0000
Subject: [PATCH] Revert "PCI: apple: Allow MSIs to be system wakeup
 interrupts"

This reverts commit 1862449ba0be261171b261847df1fb1c14595b90.

Test kernel 5 replaces the prep/hw-pm series with
prep/hw-pm-v5-tablemax-v2, which carries the reworked versions.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01UqitcmCNS6G33aQUShi39x
---
 drivers/pci/controller/pcie-apple.c | 20 +-------------------
 1 file changed, 1 insertion(+), 19 deletions(-)

diff --git a/drivers/pci/controller/pcie-apple.c b/drivers/pci/controller/pcie-apple.c
index 6ce624f..d58d5da 100644
--- a/drivers/pci/controller/pcie-apple.c
+++ b/drivers/pci/controller/pcie-apple.c
@@ -748,24 +748,6 @@ static int apple_pcie_setup_port(struct apple_pcie *pcie,
 	return 0;
 }
 
-static bool apple_pcie_init_dev_msi_info(struct device *dev,
-					 struct irq_domain *domain,
-					 struct irq_domain *real_parent,
-					 struct msi_domain_info *info)
-{
-	if (!msi_lib_init_dev_msi_info(dev, domain, real_parent, info))
-		return false;
-
-	/*
-	 * MSIs end up as AIC interrupts, which reach the CPUs in s2idle with
-	 * nothing to program, so let them be wakeup sources. Without this,
-	 * enable_irq_wake() fails and the PME service gives up on the root
-	 * port interrupt, so no PCIe device can wake the system.
-	 */
-	info->chip->flags |= IRQCHIP_SKIP_SET_WAKE;
-	return true;
-}
-
 static const struct msi_parent_ops apple_msi_parent_ops = {
 	.supported_flags	= (MSI_GENERIC_FLAGS_MASK	|
 				   MSI_FLAG_PCI_MSIX		|
@@ -775,7 +757,7 @@ static const struct msi_parent_ops apple_msi_parent_ops = {
 				   MSI_FLAG_PCI_MSI_MASK_PARENT),
 	.chip_flags		= MSI_CHIP_FLAG_SET_EOI,
 	.bus_select_token	= DOMAIN_BUS_PCI_MSI,
-	.init_dev_msi_info	= apple_pcie_init_dev_msi_info,
+	.init_dev_msi_info	= msi_lib_init_dev_msi_info,
 };
 
 static int apple_msi_init(struct apple_pcie *pcie)
