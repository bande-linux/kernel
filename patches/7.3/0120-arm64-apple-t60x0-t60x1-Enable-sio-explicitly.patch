From 813af13e4a119d943e27576c83fe401e48e9952f Mon Sep 17 00:00:00 2001
From: Janne Grunau <j@jannau.net>
Date: Sat, 27 Apr 2024 12:57:52 +0200
Subject: [PATCH] arm64: apple: t60x0/t60x1: Enable sio explicitly

To be removed after m1n1 does this after proper setup.

Signed-off-by: Janne Grunau <j@jannau.net>
(cherry picked from commit d8144017aa042a7357a96187e7ee014c2d554002)
---
 arch/arm64/boot/dts/apple/t600x-j314-j316.dtsi | 5 +++++
 arch/arm64/boot/dts/apple/t600x-j375.dtsi      | 5 +++++
 2 files changed, 10 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t600x-j314-j316.dtsi b/arch/arm64/boot/dts/apple/t600x-j314-j316.dtsi
index e4a5e8294e76..fb956fa1c241 100644
--- a/arch/arm64/boot/dts/apple/t600x-j314-j316.dtsi
+++ b/arch/arm64/boot/dts/apple/t600x-j314-j316.dtsi
@@ -111,6 +111,11 @@ &dcpext0 {
 	apple,dptx-phy = <3>;
 };
 
+/* remove once m1n1 enables sio nodes after setup */
+&sio {
+	status = "okay";
+};
+
 &dpaudio1 {
 	status = "okay";
 };
diff --git a/arch/arm64/boot/dts/apple/t600x-j375.dtsi b/arch/arm64/boot/dts/apple/t600x-j375.dtsi
index 13a8cdb20c58..c684657e0e19 100644
--- a/arch/arm64/boot/dts/apple/t600x-j375.dtsi
+++ b/arch/arm64/boot/dts/apple/t600x-j375.dtsi
@@ -60,6 +60,11 @@ &dcp {
 	apple,connector-type = "HDMI-A";
 };
 
+/* remove once m1n1 enables sio nodes after setup */
+&sio {
+	status = "okay";
+};
+
 /* USB Type C */
 &i2c0 {
 	hpm0: usb-pd@38 {
-- 
2.47.3

