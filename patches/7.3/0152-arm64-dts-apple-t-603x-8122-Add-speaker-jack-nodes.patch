diff --git a/arch/arm64/boot/dts/apple/t6030-j514s.dts b/arch/arm64/boot/dts/apple/t6030-j514s.dts
index a53624a..67da7fc 100644
--- a/arch/arm64/boot/dts/apple/t6030-j514s.dts
+++ b/arch/arm64/boot/dts/apple/t6030-j514s.dts
@@ -32,3 +32,43 @@ &wifi0 {
 &bluetooth0 {
 	brcm,board-type = "apple,texa";
 };
+
+&speaker_left_tweet {
+	shutdown-gpios = <&pinctrl_ap 171 GPIO_ACTIVE_HIGH>;
+	interrupts-extended = <&pinctrl_ap 29 IRQ_TYPE_LEVEL_LOW>;
+};
+
+&speaker_left_woof1 {
+	shutdown-gpios = <&pinctrl_ap 171 GPIO_ACTIVE_HIGH>;
+	interrupts-extended = <&pinctrl_ap 29 IRQ_TYPE_LEVEL_LOW>;
+};
+
+&speaker_left_woof2 {
+	shutdown-gpios = <&pinctrl_ap 171 GPIO_ACTIVE_HIGH>;
+	interrupts-extended = <&pinctrl_ap 29 IRQ_TYPE_LEVEL_LOW>;
+};
+
+&speaker_right_tweet {
+	shutdown-gpios = <&pinctrl_ap 171 GPIO_ACTIVE_HIGH>;
+	interrupts-extended = <&pinctrl_ap 29 IRQ_TYPE_LEVEL_LOW>;
+};
+
+&speaker_right_woof1 {
+	shutdown-gpios = <&pinctrl_ap 171 GPIO_ACTIVE_HIGH>;
+	interrupts-extended = <&pinctrl_ap 29 IRQ_TYPE_LEVEL_LOW>;
+};
+
+&speaker_right_woof2 {
+	shutdown-gpios = <&pinctrl_ap 171 GPIO_ACTIVE_HIGH>;
+	interrupts-extended = <&pinctrl_ap 29 IRQ_TYPE_LEVEL_LOW>;
+};
+
+&jack_codec {
+	reset-gpios = <&pinctrl_nub 21 GPIO_ACTIVE_HIGH>;
+	interrupts-extended = <&pinctrl_ap 100 IRQ_TYPE_LEVEL_LOW>;
+};
+
+&sound {
+	compatible = "apple,j514-macaudio", "apple,j314-macaudio", "apple,macaudio";
+	model = "MacBook Pro J514";
+};
