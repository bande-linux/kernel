From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mikael Hug <mikaelhug@gmail.com>
Date: Sat, 7 Nov 2026 11:42:58 +0100
Subject: [PATCH] drm: apple: audio: Add the ELD control and name the card
 after the port

PipeWire reads the sink's name and formats from an iface-PCM "ELD" control, as
hdmi-codec provides. Read it from the connector while connected and notify on
every hotplug report.

Name the card AppleHDMI or AppleDP with the DCP in its long name, so hw:CARD=
names are stable and a sink is not labelled DisplayPort on an HDMI port. The
driver name apple_dcp stays, which is what UCM matches on.
---
 drivers/gpu/drm/apple/audio.c | 68 +++++++++++++++++++++++++++++++----
 drivers/gpu/drm/apple/dcp.c   | 14 ++++++++
 drivers/gpu/drm/apple/dcp.h   |  1 +
 3 files changed, 76 insertions(+), 7 deletions(-)

diff --git a/drivers/gpu/drm/apple/audio.c b/drivers/gpu/drm/apple/audio.c
index 6837749b71d3..5ce79d460e29 100644
--- a/drivers/gpu/drm/apple/audio.c
+++ b/drivers/gpu/drm/apple/audio.c
@@ -3,10 +3,6 @@
  * DCP Audio Bits
  *
  * Copyright (C) The Asahi Linux Contributors
- *
- * TODO:
- *  - figure some nice identification of the sound card (in case
- *    there's many DCP instances)
  */
 
 #include <linux/component.h>
@@ -17,6 +13,8 @@
 #include <linux/of_platform.h>
 #include <linux/platform_device.h>
 #include <linux/pm_runtime.h>
+#include <drm/drm_connector.h>
+#include <sound/control.h>
 #include <sound/dmaengine_pcm.h>
 #include <sound/pcm.h>
 #include <sound/pcm_params.h>
@@ -41,6 +39,7 @@ struct dcp_audio {
 	struct dma_chan *chan;
 	struct snd_card *card;
 	struct snd_jack *jack;
+	struct snd_kcontrol *eld_ctl;
 	struct snd_pcm_substream *substream;
 
 	struct mutex report_lock;
@@ -563,11 +562,53 @@ static void dcpaud_report_hotplug(struct dcp_audio *dcpaud, bool connected)
 	mutex_unlock(&dcpaud->data_lock);
 
 	snd_jack_report(dcpaud->jack, connected ? SND_JACK_AVOUT : 0);
+	snd_ctl_notify(dcpaud->card, SNDRV_CTL_EVENT_MASK_VALUE,
+		       &dcpaud->eld_ctl->id);
 
 	if (!connected)
 		snd_pcm_stop_xrun(dcpaud->substream);
 }
 
+static int dcpaud_eld_ctl_info(struct snd_kcontrol *kcontrol,
+			       struct snd_ctl_elem_info *uinfo)
+{
+	uinfo->type = SNDRV_CTL_ELEM_TYPE_BYTES;
+	uinfo->count = MAX_ELD_BYTES;
+
+	return 0;
+}
+
+static int dcpaud_eld_ctl_get(struct snd_kcontrol *kcontrol,
+			      struct snd_ctl_elem_value *ucontrol)
+{
+	struct dcp_audio *dcpaud = snd_kcontrol_chip(kcontrol);
+	unsigned int cookie;
+
+	memset(ucontrol->value.bytes.data, 0, MAX_ELD_BYTES);
+	if (dcpaud_connection(dcpaud, &cookie))
+		dcp_get_eld(to_platform_device(dcpaud->dcp_dev),
+			    ucontrol->value.bytes.data, MAX_ELD_BYTES);
+
+	return 0;
+}
+
+static const struct snd_kcontrol_new dcpaud_eld_ctl = {
+	.access	= SNDRV_CTL_ELEM_ACCESS_READ | SNDRV_CTL_ELEM_ACCESS_VOLATILE,
+	.iface	= SNDRV_CTL_ELEM_IFACE_PCM,
+	.name	= "ELD",
+	.info	= dcpaud_eld_ctl_info,
+	.get	= dcpaud_eld_ctl_get,
+};
+
+static int dcpaud_create_eld_ctl(struct dcp_audio *dcpaud)
+{
+	dcpaud->eld_ctl = snd_ctl_new1(&dcpaud_eld_ctl, dcpaud);
+	if (!dcpaud->eld_ctl)
+		return -ENOMEM;
+
+	return snd_ctl_add(dcpaud->card, dcpaud->eld_ctl);
+}
+
 static int dcpaud_create_jack(struct dcp_audio *dcpaud)
 {
 	struct snd_card *card = dcpaud->card;
@@ -576,13 +617,21 @@ static int dcpaud_create_jack(struct dcp_audio *dcpaud)
 			    &dcpaud->jack, true, false);
 }
 
+static bool dcpaud_is_hdmi(struct dcp_audio *dcpaud)
+{
+	return dcp_get_connector_type(to_platform_device(dcpaud->dcp_dev)) ==
+	       DRM_MODE_CONNECTOR_HDMIA;
+}
+
 static void dcpaud_set_card_names(struct dcp_audio *dcpaud)
 {
 	struct snd_card *card = dcpaud->card;
+	const char *name = dcpaud_is_hdmi(dcpaud) ? "Apple HDMI" : "Apple DisplayPort";
 
 	strscpy(card->driver, "apple_dcp", sizeof(card->driver));
-	strscpy(card->longname, "Apple DisplayPort", sizeof(card->longname));
-	strscpy(card->shortname, "Apple DisplayPort", sizeof(card->shortname));
+	strscpy(card->shortname, name, sizeof(card->shortname));
+	snprintf(card->longname, sizeof(card->longname), "%s (%s)", name,
+		 dev_name(dcpaud->dcp_dev));
 }
 
 #ifdef CONFIG_SND_DEBUG
@@ -609,7 +658,8 @@ static int dcpaud_init_snd_card(struct dcp_audio *dcpaud)
 		return -ENODEV;
 
 
-	ret = snd_card_new(dcpaud->dev, SNDRV_DEFAULT_IDX1, SNDRV_DEFAULT_STR1,
+	ret = snd_card_new(dcpaud->dev, SNDRV_DEFAULT_IDX1,
+			   dcpaud_is_hdmi(dcpaud) ? "AppleHDMI" : "AppleDP",
 			   THIS_MODULE, 0, &dcpaud->card);
 	if (ret)
 		return ret;
@@ -624,6 +674,10 @@ static int dcpaud_init_snd_card(struct dcp_audio *dcpaud)
 	if (ret)
 		goto err_free_card;
 
+	ret = dcpaud_create_eld_ctl(dcpaud);
+	if (ret)
+		goto err_free_card;
+
 	ret = dcpaud_create_jack(dcpaud);
 	if (ret)
 		goto err_free_card;
diff --git a/drivers/gpu/drm/apple/dcp.c b/drivers/gpu/drm/apple/dcp.c
index 7644cb652fa3..a7973c8782fc 100644
--- a/drivers/gpu/drm/apple/dcp.c
+++ b/drivers/gpu/drm/apple/dcp.c
@@ -360,6 +360,20 @@ int dcp_get_connector_type(struct platform_device *pdev)
 	return (dcp->connector_type);
 }
 
+void dcp_get_eld(struct platform_device *pdev, u8 *eld, size_t len)
+{
+	struct apple_dcp *dcp = platform_get_drvdata(pdev);
+	struct drm_connector *connector;
+
+	if (!dcp->connector)
+		return;
+
+	connector = &dcp->connector->base;
+	mutex_lock(&connector->eld_mutex);
+	memcpy(eld, connector->eld, min(len, sizeof(connector->eld)));
+	mutex_unlock(&connector->eld_mutex);
+}
+
 #define DPTX_CONNECT_TIMEOUT msecs_to_jiffies(2000)
 
 static int dcp_dptx_connect(struct apple_dcp *dcp, u32 port)
diff --git a/drivers/gpu/drm/apple/dcp.h b/drivers/gpu/drm/apple/dcp.h
index 05d1339c7b8b..00dc058dd885 100644
--- a/drivers/gpu/drm/apple/dcp.h
+++ b/drivers/gpu/drm/apple/dcp.h
@@ -34,6 +34,7 @@ void dcp_poweron(struct platform_device *pdev);
 int dcp_set_crc(struct drm_crtc *crtc, bool enabled);
 int dcp_crtc_atomic_check(struct drm_crtc *crtc, struct drm_atomic_commit *commit);
 int dcp_get_connector_type(struct platform_device *pdev);
+void dcp_get_eld(struct platform_device *pdev, u8 *eld, size_t len);
 bool dcp_fw_compat_is_12_x(struct platform_device *pdev);
 unsigned long* dcp_get_iomfb_surfaces(struct platform_device *pdev);
 void dcp_link(struct platform_device *pdev, struct apple_crtc *apple,
