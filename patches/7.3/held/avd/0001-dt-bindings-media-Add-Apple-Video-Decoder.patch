From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mikael Hug <mikaelhug@gmail.com>
Date: Sat, 31 Oct 2026 00:45:34 +0000
Subject: [PATCH] dt-bindings: media: Add Apple Video Decoder

Describe the AVD video decode block of the Apple M2 (t8112): a Cortex-M3
coprocessor with code and data memory, a mailbox, the decoder control
registers, two mailbox interrupts, its DART and the avd_sys power state.

The nodes already exist without a binding in t8112.dtsi, t600x-dieX.dtsi,
t602x-dieX.dtsi, t6030.dtsi, t6031-dieX.dtsi and t8122.dtsi (from the
Asahi tree), so the binding lists their compatibles, following the asahi
binding. The driver supports t8112 only.

Ask-first item (binding): needs the owner's yes before merging.

Assisted-by: Claude:claude-opus-5-5
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01UqitcmCNS6G33aQUShi39x
---
 .../devicetree/bindings/media/apple,avd.yaml  | 100 ++++++++++++++++++
 1 file changed, 100 insertions(+)

diff --git a/Documentation/devicetree/bindings/media/apple,avd.yaml b/Documentation/devicetree/bindings/media/apple,avd.yaml
new file mode 100644
index 000000000..bb8f8498e
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/apple,avd.yaml
@@ -0,0 +1,100 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/apple,avd.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple Video Decoder (AVD)
+
+maintainers:
+  - Sven Peter <sven@kernel.org>
+  - Janne Grunau <j@jannau.net>
+
+description:
+  AVD is the stateless video decoder of Apple Silicon SoCs. A Cortex-M3
+  coprocessor runs firmware loaded by the operating system and forwards
+  the decoder pipeline interrupts through a mailbox.
+
+properties:
+  compatible:
+    oneOf:
+      - items:
+          - enum:
+              - apple,t6030-avd
+              - apple,t6031-avd
+          - const: apple,t8122-avd
+      - enum:
+          - apple,t6000-avd
+          - apple,t6020-avd
+          - apple,t8103-avd
+          - apple,t8112-avd
+          - apple,t8122-avd
+
+  reg:
+    items:
+      - description: coprocessor code memory
+      - description: coprocessor SRAM
+      - description: coprocessor mailbox registers
+      - description: decoder control registers
+
+  reg-names:
+    items:
+      - const: code
+      - const: sram
+      - const: mbox
+      - const: ctrl
+
+  interrupts:
+    minItems: 2
+    items:
+      - description: mailbox 0
+      - description: mailbox 1
+      - description: mailbox 2
+      - description: mailbox 3
+      - description: flag 0
+      - description: flag 1
+
+  iommus:
+    maxItems: 1
+
+  power-domains:
+    maxItems: 1
+
+  resets:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupts
+  - iommus
+  - power-domains
+  - resets
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/apple-aic.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    soc {
+        #address-cells = <2>;
+        #size-cells = <2>;
+
+        video-codec@269080000 {
+            compatible = "apple,t8112-avd";
+            reg = <0x2 0x69080000 0x0 0x10000>,
+                  <0x2 0x69090000 0x0 0x10000>,
+                  <0x2 0x690a0000 0x0 0x4000>,
+                  <0x2 0x69100000 0x0 0x10000>;
+            reg-names = "code", "sram", "mbox", "ctrl";
+            interrupt-parent = <&aic>;
+            interrupts = <AIC_IRQ 667 IRQ_TYPE_LEVEL_HIGH>,
+                         <AIC_IRQ 668 IRQ_TYPE_LEVEL_HIGH>;
+            iommus = <&avd_dart 0>;
+            power-domains = <&ps_avd_sys>;
+            resets = <&ps_avd_sys>;
+        };
+    };
