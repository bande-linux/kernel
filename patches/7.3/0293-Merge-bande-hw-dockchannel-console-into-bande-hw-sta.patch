From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mikael Hug <mikaelhug@gmail.com>
Date: Wed, 28 Oct 2026 11:49:53 +0100
Subject: [PATCH] Merge bande-hw/dockchannel-console into bande-hw/staging

---
 arch/arm64/boot/dts/apple/t8112-j473.dts |   4 +
 arch/arm64/boot/dts/apple/t8112.dtsi     |   8 ++
 drivers/tty/hvc/Kconfig                  |  10 ++
 drivers/tty/hvc/Makefile                 |   1 +
 drivers/tty/hvc/hvc_dockchannel.c        | 132 +++++++++++++++++++++++
 5 files changed, 155 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8112-j473.dts b/arch/arm64/boot/dts/apple/t8112-j473.dts
index b9fa3cc..89608bd 100644
--- a/arch/arm64/boot/dts/apple/t8112-j473.dts
+++ b/arch/arm64/boot/dts/apple/t8112-j473.dts
@@ -27,6 +27,10 @@ aliases {
 	};
 };
 
+&dockchannel_uart {
+	status = "okay";
+};
+
 &framebuffer0 {
 	power-domains = <&ps_dispext_cpu0>, <&ps_dptx_ext_phy>;
 };
diff --git a/arch/arm64/boot/dts/apple/t8112.dtsi b/arch/arm64/boot/dts/apple/t8112.dtsi
index 8ae5504..44c3ade 100644
--- a/arch/arm64/boot/dts/apple/t8112.dtsi
+++ b/arch/arm64/boot/dts/apple/t8112.dtsi
@@ -1321,6 +1321,14 @@ dptxphy: phy@23c500000 {
 			status = "disabled"; /* only used on j473 */
 		};
 
+		dockchannel_uart: serial@23d128000 {
+			compatible = "apple,t8112-dockchannel-uart", "apple,dockchannel-uart";
+			reg = <0x2 0x3d128000 0x0 0x4000>,
+				<0x2 0x3d12c000 0x0 0x4000>;
+			reg-names = "config", "data";
+			status = "disabled";
+		};
+
 		pinctrl_nub: pinctrl@23d1f0000 {
 			compatible = "apple,t8112-pinctrl", "apple,pinctrl";
 			reg = <0x2 0x3d1f0000 0x0 0x4000>;
diff --git a/drivers/tty/hvc/Kconfig b/drivers/tty/hvc/Kconfig
index 5866195..65c0f32 100644
--- a/drivers/tty/hvc/Kconfig
+++ b/drivers/tty/hvc/Kconfig
@@ -87,6 +87,16 @@ config HVC_DCC
 	  driver. This console is used through a JTAG only on ARM. If you don't have
 	  a JTAG then you probably don't want this option.
 
+config HVC_DOCKCHANNEL
+	bool "Apple dockchannel UART console"
+	depends on ARCH_APPLE || COMPILE_TEST
+	depends on ARM64
+	select HVC_DRIVER
+	select SERIAL_CORE_CONSOLE
+	help
+	  Console on the dockchannel FIFO that Apple Silicon Macs expose to
+	  another Mac over the debug USB channel of their DFU USB-C port.
+
 config HVC_DCC_SERIALIZE_SMP
 	bool "Use DCC only on CPU core 0"
 	depends on SMP && HVC_DCC
diff --git a/drivers/tty/hvc/Makefile b/drivers/tty/hvc/Makefile
index 98880e3..8a98f83 100644
--- a/drivers/tty/hvc/Makefile
+++ b/drivers/tty/hvc/Makefile
@@ -4,6 +4,7 @@ obj-$(CONFIG_HVC_OPAL)		+= hvc_opal.o hvsi_lib.o
 obj-$(CONFIG_HVC_OLD_HVSI)	+= hvsi.o
 obj-$(CONFIG_HVC_RTAS)		+= hvc_rtas.o
 obj-$(CONFIG_HVC_DCC)		+= hvc_dcc.o
+obj-$(CONFIG_HVC_DOCKCHANNEL)	+= hvc_dockchannel.o
 obj-$(CONFIG_HVC_DRIVER)	+= hvc_console.o
 obj-$(CONFIG_HVC_IRQ)		+= hvc_irq.o
 obj-$(CONFIG_HVC_XEN)		+= hvc_xen.o
diff --git a/drivers/tty/hvc/hvc_dockchannel.c b/drivers/tty/hvc/hvc_dockchannel.c
new file mode 100644
index 0000000..289928c
--- /dev/null
+++ b/drivers/tty/hvc/hvc_dockchannel.c
@@ -0,0 +1,132 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+
+#include <linux/console.h>
+#include <linux/delay.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/mod_devicetable.h>
+#include <linux/platform_device.h>
+#include <linux/serial_core.h>
+
+#include <asm/fixmap.h>
+
+#include "hvc_console.h"
+
+/* Data FIFO layout, from the m1n1 dockchannel UART and Asahi's dockchannel driver */
+#define DATA_TX8	0x4
+#define DATA_TX_FREE	0x14
+#define DATA_RX8	0x1c
+#define DATA_RX_COUNT	0x2c
+
+#define TX_WAIT_US	10000
+
+static void __iomem *dc_base;
+static bool dc_stalled;
+
+static size_t dc_tx(void __iomem *base, const u8 *buf, size_t count)
+{
+	size_t sent = 0;
+	unsigned int waited = 0;
+
+	while (sent < count) {
+		u32 free = readl_relaxed(base + DATA_TX_FREE);
+
+		if (!free) {
+			if (dc_stalled || waited >= TX_WAIT_US) {
+				dc_stalled = true;
+				break;
+			}
+			udelay(1);
+			waited++;
+			continue;
+		}
+
+		dc_stalled = false;
+		for (; free && sent < count; free--)
+			writel_relaxed(buf[sent++], base + DATA_TX8);
+	}
+
+	return sent;
+}
+
+static ssize_t dc_put_chars(u32 vtermno, const u8 *buf, size_t count)
+{
+	return dc_tx(dc_base, buf, count);
+}
+
+static ssize_t dc_get_chars(u32 vtermno, u8 *buf, size_t count)
+{
+	size_t i;
+
+	for (i = 0; i < count; i++) {
+		if (!readl_relaxed(dc_base + DATA_RX_COUNT))
+			break;
+		buf[i] = readl_relaxed(dc_base + DATA_RX8) >> 8;
+	}
+
+	return i;
+}
+
+static const struct hv_ops dc_ops = {
+	.get_chars = dc_get_chars,
+	.put_chars = dc_put_chars,
+};
+
+static int dc_probe(struct platform_device *pdev)
+{
+	struct hvc_struct *hp;
+
+	dc_base = devm_platform_ioremap_resource_byname(pdev, "data");
+	if (IS_ERR(dc_base))
+		return PTR_ERR(dc_base);
+
+	hvc_instantiate(0, 0, &dc_ops);
+
+	hp = hvc_alloc(0, 0, &dc_ops, 256);
+	if (IS_ERR(hp))
+		return PTR_ERR(hp);
+
+	platform_set_drvdata(pdev, hp);
+	return 0;
+}
+
+static const struct of_device_id dc_of_match[] = {
+	{ .compatible = "apple,dockchannel-uart" },
+	{}
+};
+
+static struct platform_driver dc_driver = {
+	.driver = {
+		.name = "hvc-dockchannel",
+		.of_match_table = dc_of_match,
+		.suppress_bind_attrs = true,
+	},
+	.probe = dc_probe,
+};
+builtin_platform_driver(dc_driver);
+
+static void dc_early_write(struct console *con, const char *s, unsigned int n)
+{
+	struct earlycon_device *dev = con->data;
+	const u8 cr = '\r';
+
+	for (; n; n--, s++) {
+		if (*s == '\n')
+			dc_tx(dev->port.membase, &cr, 1);
+		dc_tx(dev->port.membase, (const u8 *)s, 1);
+	}
+}
+
+static int __init dc_early_setup(struct earlycon_device *device, const char *opt)
+{
+	if (!device->port.membase)
+		return -ENODEV;
+
+	/* Apple SoC MMIO outside PCIe faults on posted writes */
+	__set_fixmap(FIX_EARLYCON_MEM_BASE, device->port.mapbase,
+		     __pgprot(PROT_DEVICE_nGnRnE));
+
+	device->con->write = dc_early_write;
+	return 0;
+}
+EARLYCON_DECLARE(dockchannel, dc_early_setup);
