+    patternProperties:
+      "^dai-tdm-idle-mode-[0-7]$":
+        description: |
+          How CODEC N of this link drives the TX slots in its
+          dai-tdm-slot-tx-idle-mask-N, slots of the shared data line in which
+          it does not transmit, so that they do not float. CODECs are numbered
+          across the link in codec sound-dai order.
+            zero: drive the slots low.
+            pulldown: weakly pull the slots low.
+        $ref: /schemas/types.yaml#/definitions/string
+        enum:
+          - zero
+          - pulldown
+
+      "^dai-tdm-slot-tx-idle-mask-[0-7]$":
+        description:
