From b6676565a98e67be4b0bc949546f2c727f55e996 Mon Sep 17 00:00:00 2001
From: Janne Grunau <j@jannau.net>
Date: Sun, 28 Jun 2026 19:55:44 +0200
Subject: [PATCH] arm64: dts: apple: t603x/t8122-j504: Use new codec bus keeper
 configuration

Signed-off-by: Janne Grunau <j@jannau.net>
(cherry picked from commit 4aa0ae456bc89d063a15a652e7be5fc943e63ba9)
---
 arch/arm64/boot/dts/apple/t603x-j514-j516.dtsi | 6 ++++--
 arch/arm64/boot/dts/apple/t8122-j504.dts       | 6 ++++--
 2 files changed, 8 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t603x-j514-j516.dtsi b/arch/arm64/boot/dts/apple/t603x-j514-j516.dtsi
index 592db69e1720..368619ac2631 100644
--- a/arch/arm64/boot/dts/apple/t603x-j514-j516.dtsi
+++ b/arch/arm64/boot/dts/apple/t603x-j514-j516.dtsi
@@ -128,7 +128,6 @@ speaker_left_woof1: codec@38 {
 		interrupts-extended = <&pinctrl_ap 29 IRQ_TYPE_LEVEL_LOW>;
 		ti,imon-slot-no = <0>;
 		ti,vmon-slot-no = <2>;
-		ti,sdout-force-zero-mask = <0xf0f0f0>;
 	};
 
 	speaker_left_woof2: codec@39 {
@@ -179,7 +178,6 @@ speaker_right_woof1: codec@3b {
 		interrupts-extended = <&pinctrl_ap 29 IRQ_TYPE_LEVEL_LOW>;
 		ti,imon-slot-no = <4>;
 		ti,vmon-slot-no = <6>;
-		ti,sdout-force-zero-mask = <0x0f0f0f>;
 	};
 
 	speaker_right_woof2: codec@3c {
@@ -249,6 +247,10 @@ sound: sound {
 
 		dai-link@0 {
 			link-name = "Speakers";
+			dai-tdm-idle-mode-0 = "zero";
+			dai-tdm-idle-mode-3 = "zero";
+			dai-tdm-slot-tx-idle-mask-0 = <0xf0f0f0>;
+			dai-tdm-slot-tx-idle-mask-3 = <0x0f0f0f>;
 
 			cpu {
 				sound-dai = <&mca 0>, <&mca 1>;
diff --git a/arch/arm64/boot/dts/apple/t8122-j504.dts b/arch/arm64/boot/dts/apple/t8122-j504.dts
index 47441684f77a..f45c19883be5 100644
--- a/arch/arm64/boot/dts/apple/t8122-j504.dts
+++ b/arch/arm64/boot/dts/apple/t8122-j504.dts
@@ -124,7 +124,6 @@ speaker_left_woof1: codec@38 {
 		interrupts-extended = <&pinctrl_ap 12 IRQ_TYPE_LEVEL_LOW>;
 		ti,imon-slot-no = <0>;
 		ti,vmon-slot-no = <2>;
-		ti,sdout-force-zero-mask = <0x0f0f0f>;
 	};
 
 	speaker_left_woof2: codec@39 {
@@ -171,7 +170,6 @@ speaker_right_woof1: codec@3b {
 		interrupts-extended = <&pinctrl_ap 12 IRQ_TYPE_LEVEL_LOW>;
 		ti,imon-slot-no = <4>;
 		ti,vmon-slot-no = <6>;
-		ti,sdout-force-zero-mask = <0xf0f0f0>;
 	};
 
 	speaker_right_woof2: codec@3c {
@@ -193,6 +191,10 @@ sound: sound {
 
 		dai-link@0 {
 			link-name = "Speakers";
+			dai-tdm-idle-mode-0 = "zero";
+			dai-tdm-idle-mode-3 = "zero";
+			dai-tdm-slot-tx-idle-mask-0 = <0x0f0f0f>;
+			dai-tdm-slot-tx-idle-mask-3 = <0xf0f0f0>;
 
 			cpu {
 				sound-dai = <&mca 0>, <&mca 1>;
-- 
2.47.3

