From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Janne Grunau <j@jannau.net>
Date: Sat, 6 Sep 2025 11:23:03 +0200
Subject: [PATCH] arm64: dts: apple: t600x: Add "pm_setting" for smc_reboot

For backawrds compatibility with the downstream driver.

Signed-off-by: Janne Grunau <j@jannau.net>
(cherry picked from commit 57aac566ecedda897e817bd9abd170914b2e8f23)
---
 arch/arm64/boot/dts/apple/t600x-die0.dtsi | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t600x-die0.dtsi b/arch/arm64/boot/dts/apple/t600x-die0.dtsi
index 654574c..4b197c9 100644
--- a/arch/arm64/boot/dts/apple/t600x-die0.dtsi
+++ b/arch/arm64/boot/dts/apple/t600x-die0.dtsi
@@ -53,9 +53,9 @@ smc_gpio: gpio {
 		smc_reboot: reboot {
 			compatible = "apple,smc-reboot";
 			nvmem-cells = <&shutdown_flag>, <&boot_stage>,
-				<&boot_error_count>, <&panic_count>;
+				<&boot_error_count>, <&panic_count>, <&pm_setting>;
 			nvmem-cell-names = "shutdown_flag", "boot_stage",
-				"boot_error_count", "panic_count";
+				"boot_error_count", "panic_count", "pm_setting";
 		};
 
 		smc_hwmon: hwmon {
