@@ -36,7 +36,10 @@ required:
   - compatible
   - reg
 
-additionalProperties: false
+allOf:
+  - $ref: dai-common.yaml#
+
+unevaluatedProperties: false
 
 examples:
   - |
@@ -49,8 +52,9 @@ examples:
       jack_codec: codec@4b {
           compatible = "cirrus,cs42l84";
           reg = <0x4b>;
