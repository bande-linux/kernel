Subject: [PATCH] arm64: dts: apple: t603x: Add usb/atcphy nodes

Signed-off-by: Sasha Finkelstein <k@chaosmail.tech>
(cherry picked from commit 4d3fd2b610d52e1731f186865b3dd4d3106c62bd)
---
 arch/arm64/boot/dts/apple/t6030.dtsi          | 161 ++++++++++++++
 arch/arm64/boot/dts/apple/t6031-dieX.dtsi     | 159 ++++++++++++++
 arch/arm64/boot/dts/apple/t6031.dtsi          |   1 +
 .../arm64/boot/dts/apple/t603x-j514-j516.dtsi | 198 ++++++++++++++++++
 4 files changed, 519 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t6030.dtsi b/arch/arm64/boot/dts/apple/t6030.dtsi
index 2ceb60aafebd..a1fc24574811 100644
--- a/arch/arm64/boot/dts/apple/t6030.dtsi
+++ b/arch/arm64/boot/dts/apple/t6030.dtsi
@@ -11,6 +11,7 @@
 #include <dt-bindings/interrupt-controller/apple-aic.h>
 #include <dt-bindings/interrupt-controller/irq.h>
 #include <dt-bindings/pinctrl/apple.h>
+#include <dt-bindings/phy/phy.h>
 #include <dt-bindings/spmi/spmi.h>
 
 / {
@@ -1367,6 +1368,166 @@ pcie0_dart_3: iommu@597000000 {
 			power-domains = <&ps_apcie_sys_gp>;
 			status = "disabled";
 		};
+
+		dwc3_0: usb@702280000 {
+			compatible = "apple,t6030-dwc3", "apple,t8103-dwc3";
+			reg = <0x7 0x02280000 0x0 0xcd00>, <0x7 0x0228cd00 0x0 0x3200>;
+			reg-names = "dwc3-core", "dwc3-apple";
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 1087 IRQ_TYPE_LEVEL_HIGH>;
+			dr_mode = "otg";
+			usb-role-switch;
+			role-switch-default-mode = "host";
+			iommus = <&dwc3_0_dart_0 0>,
+				<&dwc3_0_dart_1 1>;
+			power-domains = <&ps_atc0_usb>;
+			resets = <&atcphy0>;
+			phys = <&atcphy0 PHY_TYPE_USB2>, <&atcphy0 PHY_TYPE_USB3>;
+			phy-names = "usb2-phy", "usb3-phy";
+		};
+
+		dwc3_0_dart_0: iommu@702f00000 {
+			compatible = "apple,t6030-dart", "apple,t8110-dart";
+			reg = <0x7 0x02f00000 0x0 0x4000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 1091 IRQ_TYPE_LEVEL_HIGH>;
+			power-domains = <&ps_atc0_usb>;
+			#iommu-cells = <1>;
+		};
+
+		dwc3_0_dart_1: iommu@702f80000 {
+			compatible = "apple,t6030-dart", "apple,t8110-dart";
+			reg = <0x7 0x02f80000 0x0 0x4000>;
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 1091 IRQ_TYPE_LEVEL_HIGH>;
+			power-domains = <&ps_atc0_usb>;
+			#iommu-cells = <1>;
+		};
+
+		atcphy0: phy@703000000 {
+			compatible = "apple,t6030-atcphy", "apple,t8122-atcphy";
+			reg = <0x7 0x03000000 0x0 0x4c000>,
+				<0x7 0x03050000 0x0 0x8000>,
+				<0x7 0x00000000 0x0 0x8000>,
+				<0x7 0x02a90000 0x0 0x4000>,
+				<0x7 0x02a84000 0x0 0x4000>;
+			reg-names = "core", "lpdptx", "axi2af", "usb2phy",
+				"pipehandler";
+
+			#phy-cells = <1>;
+			#reset-cells = <0>;
+
+			orientation-switch;
+			mode-switch;
+			power-domains = <&ps_atc0_usb>;
+		};
+
+		dwc3_1: usb@b02280000 {
+			compatible = "apple,t6030-dwc3", "apple,t8103-dwc3";
+			reg = <0xb 0x02280000 0x0 0xcd00>, <0xb 0x0228cd00 0x0 0x3200>;
+			reg-names = "dwc3-core", "dwc3-apple";
