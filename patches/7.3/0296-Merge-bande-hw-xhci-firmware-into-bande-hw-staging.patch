From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mikael Hug <mikaelhug@gmail.com>
Date: Wed, 28 Oct 2026 12:02:39 +0100
Subject: [PATCH] Merge bande-hw/xhci-firmware into bande-hw/staging

---
 drivers/usb/host/xhci-pci-asmedia.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/drivers/usb/host/xhci-pci-asmedia.c b/drivers/usb/host/xhci-pci-asmedia.c
index d6b12f5..7506ffd 100644
--- a/drivers/usb/host/xhci-pci-asmedia.c
+++ b/drivers/usb/host/xhci-pci-asmedia.c
@@ -5,6 +5,7 @@
  */
 
 #include <linux/acpi.h>
+#include <linux/bitfield.h>
 #include <linux/firmware.h>
 #include <linux/pci.h>
 #include <linux/iopoll.h>
@@ -162,7 +163,7 @@ static int asmedia_wait_reset(struct pci_dev *pdev)
 	u32 val;
 	int ret;
 
-	op = hcd->regs + HC_LENGTH(readl(&cap->hc_capbase));
+	op = hcd->regs + FIELD_GET(HC_LENGTH, readl(&cap->hc_capbase));
 
 	ret = readl_poll_timeout(&op->command,
 				 val, !(val & CMD_RESET),
