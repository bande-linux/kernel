From 56b96f4173459e763591bca5941bd410d78f7543 Mon Sep 17 00:00:00 2001
From: Sasha Finkelstein <k@chaosmail.tech>
Date: Tue, 2 Jun 2026 23:19:54 +0200
Subject: [PATCH] dts: apple: t603x: Add SMC hwmon nodes

Signed-off-by: Sasha Finkelstein <k@chaosmail.tech>
(cherry picked from commit 71734771968345192eee927de01b732e672ad6d7)
---
 arch/arm64/boot/dts/apple/t6030.dtsi           | 4 ++++
 arch/arm64/boot/dts/apple/t6031-die0.dtsi      | 4 ++++
 arch/arm64/boot/dts/apple/t6032-j575d.dts      | 2 ++
 arch/arm64/boot/dts/apple/t603x-j514-j516.dtsi | 3 +++
 4 files changed, 13 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t6030.dtsi b/arch/arm64/boot/dts/apple/t6030.dtsi
index be03c16a11a4..d85cda6416a0 100644
--- a/arch/arm64/boot/dts/apple/t6030.dtsi
+++ b/arch/arm64/boot/dts/apple/t6030.dtsi
@@ -865,6 +865,10 @@ smc_gpio_low: gpio@67700000 {
 				#gpio-cells = <2>;
 			};
 
+			smc_hwmon: hwmon {
+				compatible = "apple,smc-hwmon";
+			};
+
 			smc_reboot: reboot {
 				compatible = "apple,smc-reboot";
 				nvmem-cells = <&shutdown_flag>, <&boot_stage>,
diff --git a/arch/arm64/boot/dts/apple/t6031-die0.dtsi b/arch/arm64/boot/dts/apple/t6031-die0.dtsi
index 46b1e2ffc8c2..600dedf578d8 100644
--- a/arch/arm64/boot/dts/apple/t6031-die0.dtsi
+++ b/arch/arm64/boot/dts/apple/t6031-die0.dtsi
@@ -122,6 +122,10 @@ smc_gpio_low: gpio@67700000 {
 			#gpio-cells = <2>;
 		};
 
+		smc_hwmon: hwmon {
+			compatible = "apple,smc-hwmon";
+		};
+
 		smc_reboot: reboot {
 			compatible = "apple,smc-reboot";
 			nvmem-cells = <&shutdown_flag>, <&boot_stage>,
diff --git a/arch/arm64/boot/dts/apple/t6032-j575d.dts b/arch/arm64/boot/dts/apple/t6032-j575d.dts
index fb96cc16031d..9448c7a84b6a 100644
--- a/arch/arm64/boot/dts/apple/t6032-j575d.dts
+++ b/arch/arm64/boot/dts/apple/t6032-j575d.dts
@@ -51,3 +51,5 @@ &nco_clkref {
 };
 
 #include "spi1-nvram.dtsi"
+#include "hwmon-common.dtsi"
+#include "hwmon-fan-dual.dtsi"
diff --git a/arch/arm64/boot/dts/apple/t603x-j514-j516.dtsi b/arch/arm64/boot/dts/apple/t603x-j514-j516.dtsi
index fbd492b8d79b..dd5ade45a829 100644
--- a/arch/arm64/boot/dts/apple/t603x-j514-j516.dtsi
+++ b/arch/arm64/boot/dts/apple/t603x-j514-j516.dtsi
@@ -114,3 +114,6 @@ &pcie0_dart_1 {
 };
 
 #include "spi1-nvram.dtsi"
+#include "hwmon-common.dtsi"
+#include "hwmon-fan-dual.dtsi"
+#include "hwmon-laptop.dtsi"
