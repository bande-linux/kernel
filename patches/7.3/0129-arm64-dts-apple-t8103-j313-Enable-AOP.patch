From 2daba9a9bcafdabdc7797695bd87c132d72a8004 Mon Sep 17 00:00:00 2001
From: Janne Grunau <j@jannau.net>
Date: Mon, 30 Dec 2024 15:09:31 +0100
Subject: [PATCH] arm64: dts: apple: t8103-j313: Enable AOP

Signed-off-by: Janne Grunau <j@jannau.net>
(cherry picked from commit d32800fb3c0c35f2459cebed26ee0f36179cfe6f)
---
 arch/arm64/boot/dts/apple/t8103-j313.dts | 24 ++++++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8103-j313.dts b/arch/arm64/boot/dts/apple/t8103-j313.dts
index 7cc6b174ec6c..1ec8bc9e40a9 100644
--- a/arch/arm64/boot/dts/apple/t8103-j313.dts
+++ b/arch/arm64/boot/dts/apple/t8103-j313.dts
@@ -18,6 +18,10 @@ / {
 	model = "Apple MacBook Air (M1, 2020)";
 	chassis-type = "laptop";
 
+	aliases {
+		sep = &sep;
+	};
+
 	led-controller {
 		compatible = "pwm-leds";
 		led-0 {
@@ -129,6 +133,26 @@ jack_codec: codec@48 {
 	};
 };
 
+&aop_mbox {
+       status = "okay";
+};
+
+&aop_dart {
+       status = "okay";
+};
+
+&aop_admac {
+       status = "okay";
+};
+
+&aop {
+	status = "okay";
+};
+
+&sep {
+	status = "okay";
+};
+
 &aop_audio {
 	apple,chassis-name = "J313";
 	apple,machine-kind = "MacBook Air";
-- 
2.47.3

