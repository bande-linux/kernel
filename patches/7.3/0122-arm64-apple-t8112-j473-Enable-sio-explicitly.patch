From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Janne Grunau <j@jannau.net>
Date: Sat, 27 Apr 2024 12:57:52 +0200
Subject: [PATCH] arm64: apple: t8112-j473: Enable sio explicitly

To be removed after m1n1 does this after proper setup.

Signed-off-by: Janne Grunau <j@jannau.net>
(cherry picked from commit 627d5d16b061248d49b03c8e65132e29d6afb120)
---
 arch/arm64/boot/dts/apple/t8112-j473.dts | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8112-j473.dts b/arch/arm64/boot/dts/apple/t8112-j473.dts
index e6d306b..b9fa3cc 100644
--- a/arch/arm64/boot/dts/apple/t8112-j473.dts
+++ b/arch/arm64/boot/dts/apple/t8112-j473.dts
@@ -66,6 +66,11 @@ &dcpext {
 	apple,dptx-phy = <5>;
 };
 
+/* remove once m1n1 enables sio nodes after setup */
+&sio {
+	status = "okay";
+};
+
 &dpaudio1 {
 	status = "okay";
 };
