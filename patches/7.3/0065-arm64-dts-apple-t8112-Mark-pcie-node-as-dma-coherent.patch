From b7c26f4cf2b3d2a89e8182d602369111b1e2b1ff Mon Sep 17 00:00:00 2001
From: Janne Grunau <j@jannau.net>
Date: Fri, 19 Sep 2025 20:32:09 +0200
Subject: [PATCH] arm64: dts: apple: t8112: Mark pcie node as dma-coherent

Signed-off-by: Janne Grunau <j@jannau.net>
(cherry picked from commit f7513a6b313e849c0ee4002fdc70c9ccdaa87dd1)
---
 arch/arm64/boot/dts/apple/t8112.dtsi | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8112.dtsi b/arch/arm64/boot/dts/apple/t8112.dtsi
index a928d4d07365..2d1e0f677f1b 100644
--- a/arch/arm64/boot/dts/apple/t8112.dtsi
+++ b/arch/arm64/boot/dts/apple/t8112.dtsi
@@ -1275,6 +1275,8 @@ pcie0: pcie@690000000 {
 			pinctrl-0 = <&pcie_pins>;
 			pinctrl-names = "default";
 
+			dma-coherent;
+
 			port00: pci@0,0 {
 				device_type = "pci";
 				reg = <0x0 0x0 0x0 0x0 0x0>;
-- 
2.47.3

