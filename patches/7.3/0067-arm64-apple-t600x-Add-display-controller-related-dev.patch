 			status = "disabled";
+			power-domains = <&ps_disp0_cpu0>;
 		};
 	};
 
@@ -48,6 +53,10 @@ &serial0 {
 	status = "okay";
 };
 
+&dcp {
+	apple,connector-type = "HDMI-A";
+};
+
 /* USB Type C */
 &i2c0 {
 	hpm0: usb-pd@38 {
