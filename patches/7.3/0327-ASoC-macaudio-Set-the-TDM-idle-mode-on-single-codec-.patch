From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mikael Hug <mikaelhug@gmail.com>
Date: Sat, 31 Oct 2026 02:58:46 +0000
Subject: [PATCH] ASoC: macaudio: Set the TDM idle mode on single-codec links
 too

macaudio_be_assign_tdm() returns right after setting the TDM slots of a
link with a single codec, so the dai-tdm-idle-mode-N and
dai-tdm-slot-tx-idle-mask-N properties are parsed for such links but
never applied. On the j473, whose speaker link has one amplifier, the
unused sense slots therefore stay Hi-Z although the device tree asks
for them to be driven low.

Apply the idle configuration on single-codec links as well, sharing the
code with the multi-codec loop.

Fixes: 193a8c373b91 ("ASoC: macaudio: Use upstreamed bus keeper configuration mechanism")
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01UqitcmCNS6G33aQUShi39x
---
 sound/soc/apple/macaudio.c | 35 +++++++++++++++++++++++++----------
 1 file changed, 25 insertions(+), 10 deletions(-)

diff --git a/sound/soc/apple/macaudio.c b/sound/soc/apple/macaudio.c
index edc4d66..03aef12 100644
--- a/sound/soc/apple/macaudio.c
+++ b/sound/soc/apple/macaudio.c
@@ -1065,6 +1065,22 @@ static const struct snd_soc_ops macaudio_be_ops = {
 	.trigger	= macaudio_be_trigger,
 };
 
+static void macaudio_be_set_tdm_idle(struct snd_soc_card *card,
+				     struct snd_soc_dai *dai,
+				     const struct ma_codec_idle *idle)
+{
+	int ret;
+
+	if (!idle->idle_mode)
+		return;
+
+	ret = snd_soc_dai_set_tdm_idle(dai, idle->idle_mask, 0,
+				       idle->idle_mode, 0);
+	if (ret)
+		dev_warn(card->dev, "%s: failed to set TDM idle mode: %d\n",
+			 dai->name, ret);
+}
+
 static int macaudio_be_assign_tdm(struct snd_soc_pcm_runtime *rtd)
 {
 	struct snd_soc_card *card = rtd->card;
@@ -1081,8 +1097,9 @@ static int macaudio_be_assign_tdm(struct snd_soc_pcm_runtime *rtd)
 	nslots = __fls(mask) + 1;
 
 	if (rtd->dai_link->num_codecs == 1) {
-		ret = snd_soc_dai_set_tdm_slot(snd_soc_rtd_to_codec(rtd, 0), mask,
-					       0, nslots, MACAUDIO_SLOTWIDTH);
+		dai = snd_soc_rtd_to_codec(rtd, 0);
+		ret = snd_soc_dai_set_tdm_slot(dai, mask, 0, nslots,
+					       MACAUDIO_SLOTWIDTH);
 
 		/*
 		 * Headphones get a pass on -ENOTSUPP (see the comment
@@ -1090,8 +1107,12 @@ static int macaudio_be_assign_tdm(struct snd_soc_pcm_runtime *rtd)
 		 */
 		if (ret == -ENOTSUPP && props->is_headphones)
 			return 0;
+		if (ret)
+			return ret;
 
-		return ret;
+		macaudio_be_set_tdm_idle(card, dai, &props->codecs[0]);
+
+		return 0;
 	}
 
 	for_each_rtd_codec_dais(rtd, i, dai) {
@@ -1103,13 +1124,7 @@ static int macaudio_be_assign_tdm(struct snd_soc_pcm_runtime *rtd)
 		if (ret)
 			return ret;
 
-		if (props->codecs[i].idle_mode) {
-			ret = snd_soc_dai_set_tdm_idle(dai, props->codecs[i].idle_mask,
-						       0, props->codecs[i].idle_mode, 0);
-			if (ret)
-				dev_warn(card->dev, "%s: failed to set TDM idle mode: %d\n",
-					 dai->name, ret);
-		}
+		macaudio_be_set_tdm_idle(card, dai, &props->codecs[i]);
 	}
 
 	return 0;
