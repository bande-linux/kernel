+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 1071 IRQ_TYPE_LEVEL_HIGH>,
+				<AIC_IRQ 1072 IRQ_TYPE_LEVEL_HIGH>,
+				<AIC_IRQ 1073 IRQ_TYPE_LEVEL_HIGH>,
+				<AIC_IRQ 1074 IRQ_TYPE_LEVEL_HIGH>;
