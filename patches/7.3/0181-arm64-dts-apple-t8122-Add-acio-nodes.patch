From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sasha Finkelstein <k@chaosmail.tech>
Date: Sat, 22 Aug 2026 21:22:41 +0200
Subject: [PATCH] arm64: dts: apple: t8122: Add acio nodes

Signed-off-by: Sasha Finkelstein <k@chaosmail.tech>
(cherry picked from commit a9643bee0dea754bdb5c7f2b2e77c0b05d47e9f6)
---
 arch/arm64/boot/dts/apple/t8122-jxxx.dtsi     |  47 ++++
 .../arm64/boot/dts/apple/t8122-usbpd-i2c.dtsi |  12 +
 .../boot/dts/apple/t8122-usbpd-spmi.dtsi      |  12 +
 arch/arm64/boot/dts/apple/t8122.dtsi          | 250 ++++++++++++++++++
 4 files changed, 321 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8122-jxxx.dtsi b/arch/arm64/boot/dts/apple/t8122-jxxx.dtsi
index cfd2492..6c67f34 100644
--- a/arch/arm64/boot/dts/apple/t8122-jxxx.dtsi
+++ b/arch/arm64/boot/dts/apple/t8122-jxxx.dtsi
@@ -16,6 +16,11 @@ aliases {
 		bluetooth0 = &bluetooth0;
 		serial0 = &serial0;
 		wifi0 = &wifi0;
+
+		usb4-0-acio = &usb4_0_acio;
+		usb4-0-nhi = &usb4_0_nhi;
+		usb4-1-acio = &usb4_1_acio;
+		usb4-1-nhi = &usb4_1_nhi;
 	};
 
 	chosen {
@@ -76,6 +81,48 @@ bluetooth0: bluetooth@0,1 {
 	};
 };
 
+&usb4_0_acio {
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		/* 1: USB4 port */
+		port@1 {
+			reg = <1>;
+			usb4_0_acio_tbt: endpoint {
+				remote-endpoint = <&typec0_con_tbt>;
+			};
+		};
+
+		/* 2: unused(?) USB4 port */
+		/* 3: PCIe */
+		/* 4: USB3 */
+		/* 5: DP0 */
+		/* 6: DP1 */
+	};
+};
+
+&usb4_1_acio {
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		/* 1: USB4 port */
+		port@1 {
+			reg = <1>;
+			usb4_1_acio_tbt: endpoint {
+				remote-endpoint = <&typec1_con_tbt>;
+			};
+		};
+
+		/* 2: unused(?) USB4 port */
+		/* 3: PCIe */
+		/* 4: USB3 */
+		/* 5: DP0 */
+		/* 6: DP1 */
+	};
+};
+
 /* USB controllers */
 &dwc3_0 {
 	ports {
diff --git a/arch/arm64/boot/dts/apple/t8122-usbpd-i2c.dtsi b/arch/arm64/boot/dts/apple/t8122-usbpd-i2c.dtsi
index 1da3234..87fa107 100644
--- a/arch/arm64/boot/dts/apple/t8122-usbpd-i2c.dtsi
+++ b/arch/arm64/boot/dts/apple/t8122-usbpd-i2c.dtsi
@@ -41,6 +41,12 @@ typec0_connector_ss: endpoint {
 						remote-endpoint = <&atcphy0_typec_lanes>;
 					};
 				};
+				port@2 {
+					reg = <2>;
+					typec0_con_tbt: endpoint {
+						remote-endpoint = <&usb4_0_acio_tbt>;
+					};
+				};
 			};
 		};
 	};
@@ -72,6 +78,12 @@ typec1_connector_ss: endpoint {
 						remote-endpoint = <&atcphy1_typec_lanes>;
 					};
 				};
+				port@2 {
+					reg = <2>;
+					typec1_con_tbt: endpoint {
+						remote-endpoint = <&usb4_1_acio_tbt>;
+					};
+				};
 			};
 		};
 	};
diff --git a/arch/arm64/boot/dts/apple/t8122-usbpd-spmi.dtsi b/arch/arm64/boot/dts/apple/t8122-usbpd-spmi.dtsi
index 8cc104a..1f6f3f3 100644
