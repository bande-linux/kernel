From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mikael Hug <mikaelhug@gmail.com>
Date: Fri, 30 Oct 2026 16:48:16 +0000
Subject: [PATCH] Merge prep/hw-display: DCP fixes for the M2 Mac mini

---
 drivers/gpu/drm/apple/dcp-internal.h   |  6 ++
 drivers/gpu/drm/apple/dcp.c            | 93 ++++++++++++++++++++++----
 drivers/gpu/drm/apple/dptxep.c         | 22 +++---
 drivers/gpu/drm/apple/dptxep.h         |  1 +
 drivers/gpu/drm/apple/iomfb.c          |  9 +--
 drivers/gpu/drm/apple/iomfb_template.c | 62 +++++++++++++----
 drivers/gpu/drm/apple/plane.c          | 10 +++
 7 files changed, 163 insertions(+), 40 deletions(-)

diff --git a/drivers/gpu/drm/apple/dcp-internal.h b/drivers/gpu/drm/apple/dcp-internal.h
index a2e992b..82679c7 100644
--- a/drivers/gpu/drm/apple/dcp-internal.h
+++ b/drivers/gpu/drm/apple/dcp-internal.h
@@ -141,6 +141,7 @@ struct apple_dcp {
 
 	/* DCP shared memory */
 	void *shmem;
+	dma_addr_t shmem_iova;
 
 	/* Display registers mappable to the DCP */
 	struct resource *disp_registers[MAX_DISP_REGISTERS];
@@ -260,6 +261,11 @@ struct apple_dcp {
 
 	struct mutex hpd_mutex;
 
+	struct mutex power_mutex;
+	bool powered;
+	bool client_open;
+	struct completion timings_done;
+
 	u32 dptx_phy;
 	u32 dptx_die;
 	int hdmi_hpd_irq;
diff --git a/drivers/gpu/drm/apple/dcp.c b/drivers/gpu/drm/apple/dcp.c
index 7629cf0..0419c16 100644
--- a/drivers/gpu/drm/apple/dcp.c
+++ b/drivers/gpu/drm/apple/dcp.c
@@ -378,6 +378,7 @@ static int dcp_dptx_connect(struct apple_dcp *dcp, u32 port)
 		goto out_unlock;
 
 	reinit_completion(&dcp->dptxport[port].linkcfg_completion);
+	reinit_completion(&dcp->timings_done);
 	dcp->dptxport[port].atcphy = dcp->phy;
 	dptxport_connect(dcp->dptxport[port].service, 0, dcp->dptx_phy, dcp->dptx_die);
 	dptxport_request_display(dcp->dptxport[port].service);
@@ -430,10 +431,19 @@ static int dcp_dptx_disconnect(struct apple_dcp *dcp, u32 port)
 	return 0;
 }
 
+static void dcp_read_sink_modes(struct apple_dcp *dcp);
+
 int dcp_dptx_connect_oob(struct platform_device *pdev, u32 port)
 {
 	struct apple_dcp *dcp = platform_get_drvdata(pdev);
-	return dcp_dptx_connect(dcp, port);
+	bool was_connected = dcp->dptxport[port].connected;
+	int ret;
+
+	ret = dcp_dptx_connect(dcp, port);
+	if (!ret && !was_connected)
+		dcp_read_sink_modes(dcp);
+
+	return ret;
 }
 
 int dcp_dptx_disconnect_oob(struct platform_device *pdev, u32 port)
@@ -470,8 +480,9 @@ static irqreturn_t dcp_dp2hdmi_hpd(int irq, void *data)
 		dev_info(dcp->dev, "DP2HDMI HPD irq, 500ms debounce: connected:%d\n", connected);
 	}
 
-	if (connected)
-		dcp_dptx_connect(dcp, 0);
+	if (connected && !dcp->dptxport[0].connected &&
+	    !dcp_dptx_connect(dcp, 0))
+		dcp_read_sink_modes(dcp);
 
 	return IRQ_HANDLED;
 }
@@ -652,18 +663,8 @@ static void __maybe_unused dcp_sleep(struct apple_dcp *dcp)
 	}
 }
 
-void dcp_poweron(struct platform_device *pdev)
+static void _dcp_poweron(struct apple_dcp *dcp)
 {
-	struct apple_dcp *dcp = platform_get_drvdata(pdev);
-
-	if (dcp->hdmi_hpd) {
-		bool connected = gpiod_get_value_cansleep(dcp->hdmi_hpd);
-		dev_info(dcp->dev, "%s: DP2HDMI HPD connected:%d\n", __func__, connected);
-
-		if (connected)
-			dcp_dptx_connect(dcp, 0);
-	}
-
 	switch (dcp->fw_compat) {
 	case DCP_FIRMWARE_V_12_3:
 		iomfb_poweron_v12_3(dcp);
@@ -678,6 +679,50 @@ void dcp_poweron(struct platform_device *pdev)
 		WARN_ONCE(true, "Unexpected firmware version: %u\n", dcp->fw_compat);
 		break;
 	}
+}
+
+#define DCP_TIMINGS_TIMEOUT msecs_to_jiffies(3000)
+
+/*
+ * A display requested while IOMFB is powered off is published with empty
+ * TimingElements, ColorElements and DisplayAttributes (DCP 13.5 trace, j473).
+ */
+static void dcp_read_sink_modes(struct apple_dcp *dcp)
+{
+	mutex_lock(&dcp->power_mutex);
+	if (dcp->powered)
+		goto out_unlock;
+
+	if (!wait_for_completion_timeout(&dcp->timings_done, DCP_TIMINGS_TIMEOUT) ||
+	    dcp->nr_modes)
+		goto out_unlock;
+
+	reinit_completion(&dcp->timings_done);
+	_dcp_poweron(dcp);
+	if (!wait_for_completion_timeout(&dcp->timings_done, DCP_TIMINGS_TIMEOUT))
+		dev_err(dcp->dev, "no TimingElements after power on\n");
+	_dcp_poweroff(dcp);
+
+out_unlock:
+	mutex_unlock(&dcp->power_mutex);
+}
+
+void dcp_poweron(struct platform_device *pdev)
+{
+	struct apple_dcp *dcp = platform_get_drvdata(pdev);
+
+	mutex_lock(&dcp->power_mutex);
+	if (dcp->hdmi_hpd) {
+		bool connected = gpiod_get_value_cansleep(dcp->hdmi_hpd);
+		dev_info(dcp->dev, "%s: DP2HDMI HPD connected:%d\n", __func__, connected);
+
+		if (connected)
+			dcp_dptx_connect(dcp, 0);
+	}
+
+	_dcp_poweron(dcp);
+	dcp->powered = true;
+	mutex_unlock(&dcp->power_mutex);
 
 	if (dcp->avep)
 		av_service_connect(dcp);
@@ -690,7 +735,10 @@ void dcp_poweroff(struct platform_device *pdev)
 	if (dcp->avep)
 		av_service_disconnect(dcp);
 
+	mutex_lock(&dcp->power_mutex);
 	_dcp_poweroff(dcp);
+	dcp->powered = false;
+	mutex_unlock(&dcp->power_mutex);
 
 	if (dcp->hdmi_hpd) {
 		bool connected = gpiod_get_value_cansleep(dcp->hdmi_hpd);
@@ -1008,6 +1056,8 @@ static int dcp_comp_bind(struct device *dev, struct device *main, void *data)
 		dev_info(dev, "DCP index:%u dptx target phy: %u dptx die: %u\n",
 			 dcp->index, dcp->dptx_phy, dcp->dptx_die);
 	mutex_init(&dcp->hpd_mutex);
+	mutex_init(&dcp->power_mutex);
+	init_completion(&dcp->timings_done);
 
 	if (!show_notch)
 		ret = of_property_read_u32(dev->of_node, "apple,notch-height",
@@ -1104,6 +1154,7 @@ static int dcp_comp_bind(struct device *dev, struct device *main, void *data)
 static void dcp_comp_unbind(struct device *dev, struct device *main, void *data)
 {
 	struct apple_dcp *dcp = dev_get_drvdata(dev);
+	int ret;
 
 	if (!dcp)
 		return;
@@ -1142,6 +1193,20 @@ static void dcp_comp_unbind(struct device *dev, struct device *main, void *data)
 	if (dcp->shmem)
 		iomfb_shutdown(dcp);
 
+	/* The bootloader hands the DCP over quiesced (m1n1 display_shutdown()) */
+	if (!dcp->crashed && apple_rtkit_is_running(dcp->rtk)) {
+		ret = apple_rtkit_quiesce(dcp->rtk);
+		if (ret)
+			dev_err(dev, "failed to quiesce RTKit: %d\n", ret);
+	}
+	devm_apple_rtkit_free(dev, dcp->rtk);
+	dcp->rtk = NULL;
+
+	if (dcp->shmem) {
+		dma_free_coherent(dev, DCP_SHMEM_SIZE, dcp->shmem, dcp->shmem_iova);
+		dcp->shmem = NULL;
+	}
+
 	if (dcp->piodma) {
 		dcp->iommu_dom = NULL;
 		of_platform_device_destroy(&dcp->piodma->dev, NULL);
diff --git a/drivers/gpu/drm/apple/dptxep.c b/drivers/gpu/drm/apple/dptxep.c
index 1ea0060..c9f3f52 100644
--- a/drivers/gpu/drm/apple/dptxep.c
+++ b/drivers/gpu/drm/apple/dptxep.c
@@ -193,10 +193,12 @@ dptxport_call_get_drive_settings(struct apple_epic_service *service,
 	 * retcode appears to be lane count, seeing 2 for USB-C dp alt mode
 	 * with lanes splitted for DP/USB3.
 	 */
-	if (le32_to_cpu(reply->retcode) != dptx->lane_count)
+	if (!dptx->lane_count)
+		dptx->lane_count = le32_to_cpu(reply->retcode);
+	else if (le32_to_cpu(reply->retcode) != dptx->lane_count)
 		dev_err(service->ep->dcp->dev,
-			"get_drive_settings: unexpected retcode %d\n",
-			reply->retcode);
+			"get_drive_settings: lane count %u, active %u\n",
+			le32_to_cpu(reply->retcode), dptx->lane_count);
 
 	reply->retcode = cpu_to_le32(dptx->lane_count);
 	reply->unk5 = cpu_to_le32(dptx->drive_settings[0]);
@@ -269,12 +271,12 @@ static int dptxport_call_get_max_lane_count(struct apple_epic_service *service,
 			dev_dbg(dcp->dev, "get_max_lane_count: phy lanes: %d\n",
 				phy_ops.dp.lanes);
 			// default to 4 lanes
-			dptx->lane_count = 4;
+			dptx->max_lane_count = 4;
 		} else {
-			dptx->lane_count = phy_ops.dp.lanes;
+			dptx->max_lane_count = phy_ops.dp.lanes;
 		}
 		reply->retcode = cpu_to_le32(0);
-		reply->lane_count = cpu_to_le64(dptx->lane_count);
+		reply->lane_count = cpu_to_le64(dptx->max_lane_count);
 	}
 
 	return 0;
@@ -298,9 +300,9 @@ static int dptxport_call_set_active_lane_count(struct apple_epic_service *servic
 
 	u64 lane_count = le64_to_cpu(request->lane_count);
 
-	if (dptx->lane_count < lane_count)
-		dev_err(dcp->dev, "set_active_lane_count: unexpected lane "
-			"count:%llu phy: %d\n", lane_count, dptx->lane_count);
+	if (dptx->max_lane_count && dptx->max_lane_count < lane_count)
+		dev_err(dcp->dev, "set_active_lane_count: lane count %llu above maximum %u\n",
+			lane_count, dptx->max_lane_count);
 
 	switch (lane_count) {
 	case 0 ... 2:
@@ -324,8 +326,8 @@ static int dptxport_call_set_active_lane_count(struct apple_epic_service *servic
 				return ret;
 		}
 		dptx->phy_ops.dp.set_lanes = 0;
-		dptx->lane_count = lane_count;
 	}
+	dptx->lane_count = lane_count;
 
 	reply->retcode = cpu_to_le32(retcode);
 	reply->lane_count = cpu_to_le64(lane_count);
diff --git a/drivers/gpu/drm/apple/dptxep.h b/drivers/gpu/drm/apple/dptxep.h
index 0bf2534..4549fcf 100644
--- a/drivers/gpu/drm/apple/dptxep.h
+++ b/drivers/gpu/drm/apple/dptxep.h
@@ -55,6 +55,7 @@ struct dptx_port {
 	union phy_configure_opts phy_ops;
 	struct phy *atcphy;
 	struct mux_control *mux;
+	u32 max_lane_count;
 	u32 lane_count;
 	u32 link_rate, pending_link_rate;
 	u32 drive_settings[2];
diff --git a/drivers/gpu/drm/apple/iomfb.c b/drivers/gpu/drm/apple/iomfb.c
index 5c6cca8..2704f79 100644
--- a/drivers/gpu/drm/apple/iomfb.c
+++ b/drivers/gpu/drm/apple/iomfb.c
@@ -536,13 +536,14 @@ void iomfb_recv_msg(struct apple_dcp *dcp, u64 message)
 
 int iomfb_start_rtkit(struct apple_dcp *dcp)
 {
-	dma_addr_t shmem_iova;
 	apple_rtkit_start_ep(dcp->rtk, IOMFB_ENDPOINT);
 
-	dcp->shmem = dma_alloc_coherent(dcp->dev, DCP_SHMEM_SIZE, &shmem_iova,
-					GFP_KERNEL);
+	dcp->shmem = dma_alloc_coherent(dcp->dev, DCP_SHMEM_SIZE,
+					&dcp->shmem_iova, GFP_KERNEL);
+	if (!dcp->shmem)
+		return -ENOMEM;
 
-	dcp_send_message(dcp, IOMFB_ENDPOINT, dcpep_set_shmem(shmem_iova));
+	dcp_send_message(dcp, IOMFB_ENDPOINT, dcpep_set_shmem(dcp->shmem_iova));
 
 	return 0;
 }
diff --git a/drivers/gpu/drm/apple/iomfb_template.c b/drivers/gpu/drm/apple/iomfb_template.c
index 53869e5..e8f69dd 100644
--- a/drivers/gpu/drm/apple/iomfb_template.c
+++ b/drivers/gpu/drm/apple/iomfb_template.c
@@ -581,6 +581,10 @@ static bool dcpep_process_chunks(struct apple_dcp *dcp,
 		}
 		if (dcp->nr_modes == 0)
 			dev_warn(dcp->dev, "TimingElements without valid modes!\n");
+
+		complete_all(&dcp->timings_done);
+		if (dcp->connector && dcp->connector->connected)
+			schedule_work(&dcp->connector->hotplug_wq);
 	} else if (!strcmp(req->key, "DisplayAttributes")) {
 		ret = parse_display_attributes(&ctx, &dcp->width_mm,
 					&dcp->height_mm);
@@ -803,11 +807,26 @@ static void dcp_on_set_parameter(struct apple_dcp *dcp, void *out, void *cookie)
 	dcp_set_parameter_dcp(dcp, false, &param, dcp_on_set_power_state, cookie);
 }
 
+static void dcp_on_client_open(struct apple_dcp *dcp, void *out, void *cookie)
+{
+	u32 handle;
+
+	dcp->client_open = true;
+	if (dcp->main_display) {
+		handle = 0;
+		dcp_set_display_device(dcp, false, &handle, dcp_on_set_power_state,
+				       cookie);
+	} else {
+		handle = 2;
+		dcp_set_display_device(dcp, false, &handle,
+				       dcp_on_set_parameter, cookie);
+	}
+}
+
 void DCP_FW_NAME(iomfb_poweron)(struct apple_dcp *dcp)
 {
 	struct dcp_wait_cookie *cookie;
 	int ret;
-	u32 handle;
 	dev_info(dcp->dev, "dcp_poweron() starting\n");
 
 	cookie = kzalloc(sizeof(*cookie), GFP_KERNEL);
@@ -819,15 +838,10 @@ void DCP_FW_NAME(iomfb_poweron)(struct apple_dcp *dcp)
 	/* increase refcount to ensure the receiver has a reference */
 	kref_get(&cookie->refcount);
 
-	if (dcp->main_display) {
-		handle = 0;
-		dcp_set_display_device(dcp, false, &handle, dcp_on_set_power_state,
-				       cookie);
-	} else {
-		handle = 2;
-		dcp_set_display_device(dcp, false, &handle,
-				       dcp_on_set_parameter, cookie);
-	}
+	if (dcp->client_open)
+		dcp_on_client_open(dcp, NULL, cookie);
+	else
+		dcp_first_client_open(dcp, false, dcp_on_client_open, cookie);
 	ret = wait_for_completion_timeout(&cookie->done, msecs_to_jiffies(10000));
 
 	if (ret == 0) {
@@ -870,6 +884,14 @@ static void last_client_closed_poff(struct apple_dcp *dcp, void *out, void *cook
 			    cookie);
 }
 
+#if DCP_FW_VER < DCP_FW_VERSION(14, 7, 0)
+static void client_closed_poff(struct apple_dcp *dcp, void *out, void *cookie)
+{
+	dcp->client_open = false;
+	last_client_closed_poff(dcp, out, cookie);
+}
+#endif
+
 static void aborted_swaps_dcp_poff(struct apple_dcp *dcp, void *out, void *cookie)
 {
 #if DCP_FW_VER >= DCP_FW_VERSION(14, 7, 0)
@@ -878,7 +900,7 @@ static void aborted_swaps_dcp_poff(struct apple_dcp *dcp, void *out, void *cooki
 #else
 	struct iomfb_last_client_close_req last_client_req = {};
 	iomfb_last_client_close(dcp, false, &last_client_req,
-				last_client_closed_poff, cookie);
+				client_closed_poff, cookie);
 #endif
 }
 
@@ -976,6 +998,7 @@ void DCP_FW_NAME(iomfb_poweroff)(struct apple_dcp *dcp)
 
 static void last_client_closed_sleep(struct apple_dcp *dcp, void *out, void *cookie)
 {
+	dcp->client_open = false;
 	struct dcp_set_power_state_req power_req = {
 		.unklong = 0,
 	};
@@ -1456,6 +1479,7 @@ static void res_is_main_display(struct apple_dcp *dcp, void *out, void *cookie)
 
 static void init_3(struct apple_dcp *dcp, void *out, void *cookie)
 {
+	dcp->client_open = true;
 	dcp_is_main_display(dcp, false, res_is_main_display, NULL);
 }
 
@@ -1487,6 +1511,20 @@ void DCP_FW_NAME(iomfb_shutdown)(struct apple_dcp *dcp)
 	struct dcp_set_power_state_req req = {
 		/* defaults are ok */
 	};
+	struct dcp_wait_cookie *cookie;
+	int ret;
+
+	cookie = kzalloc_obj(*cookie);
+	if (!cookie)
+		return;
+	init_completion(&cookie->done);
+	kref_init(&cookie->refcount);
+	kref_get(&cookie->refcount);
 
-	dcp_set_power_state(dcp, false, &req, NULL, NULL);
+	dcp_set_power_state(dcp, false, &req, complete_set_powerstate, cookie);
+	ret = wait_for_completion_timeout(&cookie->done, msecs_to_jiffies(1000));
+	if (ret == 0)
+		dev_warn(dcp->dev, "setPowerState(0) on shutdown timed out\n");
+
+	kref_put(&cookie->refcount, release_wait_cookie);
 }
diff --git a/drivers/gpu/drm/apple/plane.c b/drivers/gpu/drm/apple/plane.c
index bd16e53..960040f 100644
--- a/drivers/gpu/drm/apple/plane.c
+++ b/drivers/gpu/drm/apple/plane.c
@@ -10,6 +10,7 @@
 #include "iomfb_plane.h"
 #include <drm/drm_atomic.h>
 #include <drm/drm_atomic_helper.h>
+#include <drm/drm_blend.h>
 #include <drm/drm_fourcc.h>
 #include <drm/drm_fb_dma_helper.h>
 #include <drm/drm_framebuffer.h>
@@ -323,6 +324,8 @@ static void apple_plane_atomic_update(struct drm_plane *plane,
 	    fmt->format == DRM_FORMAT_XBGR8888 ||
 	    fmt->format == DRM_FORMAT_XBGR2101010)
 		is_premultiplied = true;
+	else if (fmt->has_alpha)
+		is_premultiplied = base->pixel_blend_mode == DRM_MODE_BLEND_PREMULTI;
 
 	new_state->src_rect = drm_to_dcp_rect_fp(&base->src);
 	new_state->dst_rect = drm_to_dcp_rect(&base->dst);
@@ -583,6 +586,7 @@ struct drm_plane *apple_plane_init(struct drm_device *dev,
 	struct apple_plane *plane;
 	const u32 *fmts;
 	u32 num_fmts;
+	int ret;
 
 	switch (type) {
 	case DRM_PLANE_TYPE_PRIMARY:
@@ -624,6 +628,12 @@ struct drm_plane *apple_plane_init(struct drm_device *dev,
 					  DRM_COLOR_YCBCR_BT709,
 					  DRM_COLOR_YCBCR_LIMITED_RANGE);
 
+	ret = drm_plane_create_blend_mode_property(&plane->base,
+						   BIT(DRM_MODE_BLEND_PREMULTI) |
+						   BIT(DRM_MODE_BLEND_COVERAGE));
+	if (ret)
+		return ERR_PTR(ret);
+
 	if (type == DRM_PLANE_TYPE_PRIMARY)
 		drm_plane_helper_add(&plane->base, &apple_primary_plane_helper_funcs);
 	else
