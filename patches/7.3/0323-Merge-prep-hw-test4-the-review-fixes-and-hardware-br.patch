+
+void dcp_release_memdescs(struct apple_dcp *dcp)
+{
+	unsigned int id = 1;
+
+	for_each_set_bit_from(id, dcp->memdesc_map, DCP_MAX_MAPPINGS) {
+		dcp_release_memdesc(dcp, &dcp->memdesc[id]);
+		clear_bit(id, dcp->memdesc_map);
+	}
