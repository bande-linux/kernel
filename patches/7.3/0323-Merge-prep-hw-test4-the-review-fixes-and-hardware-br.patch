diff --git a/drivers/cpufreq/apple-soc-cpufreq.c b/drivers/cpufreq/apple-soc-cpufreq.c
index 7c50ce74f911..9680b54ebc02 100644
--- a/drivers/cpufreq/apple-soc-cpufreq.c
+++ b/drivers/cpufreq/apple-soc-cpufreq.c
@@ -278,6 +278,15 @@ static int apple_soc_cpufreq_init(struct cpufreq_policy *policy)
 		goto out_free_table;
 	}
 
+	/*
+	 * The turbo-mode OPPs are the top of the range the SoC normally runs
+	 * at. Start a new policy with boost enabled, so that cpuinfo.max_freq
+	 * and the reference frequency derived from it when the policy is
+	 * created include them. A policy coming back online keeps its setting.
+	 */
+	if (!policy->boost_supported)
+		policy->boost_enabled = cpufreq_boost_enabled();
+
 	/* Get OPP levels (p-state indexes) and stash them in driver_data */
 	for (i = 0; freq_table[i].frequency != CPUFREQ_TABLE_END; i++) {
 		unsigned long rate = freq_table[i].frequency * 1000UL + 999;
@@ -341,6 +350,7 @@ static struct cpufreq_driver apple_soc_cpufreq_driver = {
 	.fast_switch	= apple_soc_cpufreq_fast_switch,
 	.register_em	= cpufreq_register_em_with_opp,
 	.set_boost	= cpufreq_boost_set_sw,
+	.boost_enabled	= true,
 	.suspend	= cpufreq_generic_suspend,
 };
 
diff --git a/drivers/cpufreq/cpufreq.c b/drivers/cpufreq/cpufreq.c
index 54dde8419bdc..509dd6f707e5 100644
--- a/drivers/cpufreq/cpufreq.c
+++ b/drivers/cpufreq/cpufreq.c
@@ -2802,6 +2802,12 @@ int cpufreq_boost_set_sw(struct cpufreq_policy *policy, int state)
 	if (!policy->freq_table)
 		return -ENXIO;
 
+	/*
+	 * cpufreq_frequency_table_cpuinfo() never lowers a cpuinfo.max_freq
+	 * set before it runs. Clear the limit so that disabling boost drops it
+	 * back to the highest non-boost frequency in the table.
+	 */
+	policy->cpuinfo.max_freq = 0;
 	ret = cpufreq_frequency_table_cpuinfo(policy);
 	if (ret)
 		pr_err("%s: Policy frequency update failed\n", __func__);
