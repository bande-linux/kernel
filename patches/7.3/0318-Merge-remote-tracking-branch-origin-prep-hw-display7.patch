-	if (ret)
+	if (ret) {
+		dev_set_drvdata(dev, NULL);
 		return ret;
+	}
 
 	ret = drmm_mode_config_init(&apple->drm);
 	if (ret)
@@ -534,6 +536,7 @@ static int apple_drm_init(struct device *dev)
 
