+static int dptxport_ack(const void *data, size_t data_size, void *reply,
+			size_t reply_size)
+{
+	memcpy(reply, data, min(reply_size, data_size));
+	if (reply_size >= 4)
+		memset(reply, 0, 4);
+	return 0;
