From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: James Calligeros <jcalligeros99@gmail.com>
Date: Tue, 8 Sep 2026 20:52:45 +1000
Subject: [PATCH] fixup! arm64: dts: apple: t[603x,8122]: Add speaker/jack
 nodes

Signed-off-by: James Calligeros <jcalligeros99@gmail.com>
(cherry picked from commit c3da9f337a94cbf81852469c7251ca28ea924f0f)
---
 arch/arm64/boot/dts/apple/t8122-j615.dts | 40 ++++++++++++++++++------
 1 file changed, 31 insertions(+), 9 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t8122-j615.dts b/arch/arm64/boot/dts/apple/t8122-j615.dts
index 99e6fd3..d5e2938 100644
--- a/arch/arm64/boot/dts/apple/t8122-j615.dts
+++ b/arch/arm64/boot/dts/apple/t8122-j615.dts
@@ -61,12 +61,12 @@ &bluetooth0 {
 };
 
 &i2c1 {
-	speaker_left_woof: codec@38 {
+	speaker_left_woof1: codec@38 {
 		compatible = "ti,sn012776", "ti,tas2764";
 		reg = <0x38>;
 		shutdown-gpios = <&pinctrl_ap 13 GPIO_ACTIVE_HIGH>;
 		#sound-dai-cells = <0>;
-		sound-name-prefix = "Left Woofer";
+		sound-name-prefix = "Left Woofer 1";
 		interrupts-extended = <&pinctrl_ap 12 IRQ_TYPE_LEVEL_LOW>;
 		ti,imon-slot-no = <0>;
 		ti,vmon-slot-no = <2>;
@@ -82,15 +82,26 @@ speaker_left_tweet: codec@39 {
 		ti,imon-slot-no = <8>;
 		ti,vmon-slot-no = <10>;
 	};
+
+	speaker_left_woof2: codec@3a {
+		compatible = "ti,sn012776", "ti,tas2764";
+		reg = <0x3a>;
+		shutdown-gpios = <&pinctrl_ap 13 GPIO_ACTIVE_HIGH>;
+		#sound-dai-cells = <0>;
+		sound-name-prefix = "Left Woofer 2";
+		interrupts-extended = <&pinctrl_ap 12 IRQ_TYPE_LEVEL_LOW>;
+		ti,imon-slot-no = <16>;
+		ti,vmon-slot-no = <18>;
+	};
 };
 
 &i2c3 {
-	speaker_right_woof: codec@3b {
+	speaker_right_woof1: codec@3b {
 		compatible = "ti,sn012776", "ti,tas2764";
 		reg = <0x3b>;
 		shutdown-gpios = <&pinctrl_ap 13 GPIO_ACTIVE_HIGH>;
 		#sound-dai-cells = <0>;
-		sound-name-prefix = "Right Woofer";
+		sound-name-prefix = "Right Woofer 1";
 		interrupts-extended = <&pinctrl_ap 12 IRQ_TYPE_LEVEL_LOW>;
 		ti,imon-slot-no = <4>;
 		ti,vmon-slot-no = <6>;
@@ -107,6 +118,17 @@ speaker_right_tweet: codec@3c {
 		ti,vmon-slot-no = <14>;
 	};
 
+	speaker_right_woof2: codec@3d {
+		compatible = "ti,sn012776", "ti,tas2764";
+		reg = <0x3d>;
+		shutdown-gpios = <&pinctrl_ap 13 GPIO_ACTIVE_HIGH>;
+		#sound-dai-cells = <0>;
+		sound-name-prefix = "Right Woofer 2";
+		interrupts-extended = <&pinctrl_ap 12 IRQ_TYPE_LEVEL_LOW>;
+		ti,imon-slot-no = <20>;
+		ti,vmon-slot-no = <22>;
+	};
+
 	jack_codec: codec@4b {
 		compatible = "cirrus,cs42l84";
 		reg = <0x4b>;
@@ -125,16 +147,16 @@ sound {
 		dai-link@0 {
 			link-name = "Speakers";
 			dai-tdm-idle-mode-0 = "zero";
-			dai-tdm-idle-mode-2 = "zero";
-			dai-tdm-slot-tx-idle-mask-0 = <0x0f0f>;
-			dai-tdm-slot-tx-idle-mask-2 = <0xf0f0>;
+			dai-tdm-idle-mode-3 = "zero";
+			dai-tdm-slot-tx-idle-mask-0 = <0x0f0f0f>;
+			dai-tdm-slot-tx-idle-mask-3 = <0xf0f0f0>;
 
 			cpu {
 				sound-dai = <&mca 0>, <&mca 1>;
 			};
 			codec {
-				sound-dai = <&speaker_left_woof>, <&speaker_left_tweet>,
-					    <&speaker_right_woof>, <&speaker_right_tweet>;
+				sound-dai = <&speaker_left_woof1>, <&speaker_left_tweet>, <&speaker_left_woof2>,
+					    <&speaker_right_woof1>, <&speaker_right_tweet>, <&speaker_right_woof2>;
 			};
 		};
 
